# Single source of truth for the Talos / Kubernetes versions used across
# the whole repo. Bump here ONLY — every consumer reads this file:
#
#   - ansible/roles/talos/defaults/main.yaml   (file lookup via role_path)
#   - ansible/roles/00-pxe/defaults/main.yaml  (file lookup via role_path)
#   - opentofu/Makefile                        (sourced -> TF_VAR_talos_version)
#   - install.sh                               (sourced -> talosctl + kubectl)
#
# Plain KEY=value, no quotes, so POSIX `.` (source) can read it and the
# Ansible regex lookup stays simple.
TALOS_VERSION=v1.9.5
KUBERNETES_VERSION=v1.32.3
# talhelper generates the Talos machine configs (see ansible/roles/talos).
# Installed by install.sh. Verify the tag exists at
# https://github.com/budimanjojo/talhelper/releases before bumping.
TALHELPER_VERSION=v3.1.10
