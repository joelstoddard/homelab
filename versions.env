# Single source of truth for the Talos / Kubernetes versions used across
# the whole repo. Bump here ONLY — every consumer reads this file:
#
#   - ansible/roles/talos/defaults/main.yaml   (file lookup via role_path)
#   - ansible/roles/00-pxe/defaults/main.yaml  (file lookup via role_path)
#   - opentofu/Makefile                        (sourced -> TF_VAR_talos_version)
#   - kubernetes/Makefile                      (sourced -> FLUX_VERSION drift guard)
#   - install.sh                               (sourced -> talosctl + kubectl + flux)
#
# Plain KEY=value, no quotes, so POSIX `.` (source) can read it and the
# Ansible regex lookup stays simple.
#
# Each Talos minor supports a window of Kubernetes minors (1.13 -> 1.31..1.36);
# check the support matrix before bumping either. A bump reinstalls nothing by
# itself — see docs/talos-bootstrap.md "Rebuild / bumping versions".
#
# Held at 1.13 until siderolabs/talos#14260 is fixed: 1.14.0 made usb-storage
# a kernel module and no longer waits for USB disks at boot, so the Pis (USB
# SSDs) land in maintenance mode on every boot.
TALOS_VERSION=v1.13.10
KUBERNETES_VERSION=v1.36.4
# talhelper generates the Talos machine configs (see ansible/roles/talos).
# Installed by install.sh. The project was archived on 2026-08-26; v3.1.17 is
# the final release (its embedded Talos machinery is 1.14, so it stops here).
# Releases stay downloadable from the read-only repo. Replacing it is a TODO.
TALHELPER_VERSION=v3.1.17
# Flux CD. kubernetes/flux-system/gotk-components.yaml is generated from this
# (`make -C kubernetes generate`); the Makefile's lint refuses to run if the
# two disagree. Keep the v prefix: `flux install --version` insists on it.
FLUX_VERSION=v2.9.5
