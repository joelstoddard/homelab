// Kubernetes events as log lines (logfmt: type, reason, object, message).
// Runs in the single-replica alloy-events Deployment, not the DaemonSet.

loki.source.kubernetes_events "events" {
	forward_to = [loki.write.loki.receiver]
}

loki.write "loki" {
	endpoint {
		url = "http://loki.monitoring.svc:3100/loki/api/v1/push"
	}
}
