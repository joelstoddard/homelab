// Grafana Alloy, one instance per node. Per-node blocks filter to NODE_NAME
// and are never clustered; cluster-wide blocks carry `clustering { enabled =
// true }` so the DaemonSet shares the targets. docs/design/observability.md.

// ---------------------------------------------------------------- sinks --

prometheus.remote_write "prometheus" {
	endpoint {
		url = "http://prometheus-server.monitoring.svc/api/v1/write"
	}
}

loki.write "loki" {
	endpoint {
		url = "http://loki.monitoring.svc:3100/loki/api/v1/push"
	}
}

// ------------------------------------------ this node: kubelet + cAdvisor --

discovery.kubernetes "node" {
	role = "node"

	selectors {
		role  = "node"
		field = "metadata.name=" + sys.env("NODE_NAME")
	}
}

// Both paths share job="kubelet" and differ by metrics_path, as kube-prometheus
// does and the dashboards expect. Talos kubelet serving certs are self-signed.
discovery.relabel "kubelet" {
	targets = discovery.kubernetes.node.targets

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		target_label  = "node"
	}

	rule {
		target_label = "metrics_path"
		replacement  = "/metrics"
	}
}

discovery.relabel "cadvisor" {
	targets = discovery.kubernetes.node.targets

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		target_label  = "node"
	}

	rule {
		target_label = "metrics_path"
		replacement  = "/metrics/cadvisor"
	}
}

prometheus.scrape "kubelet" {
	targets           = discovery.relabel.kubelet.output
	forward_to        = [prometheus.relabel.kube_components.receiver]
	job_name          = "kubelet"
	metrics_path      = "/metrics"
	scheme            = "https"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
	scrape_interval   = "60s"

	tls_config {
		insecure_skip_verify = true
	}
}

prometheus.scrape "cadvisor" {
	targets           = discovery.relabel.cadvisor.output
	forward_to        = [prometheus.relabel.cadvisor.receiver]
	job_name          = "kubelet"
	metrics_path      = "/metrics/cadvisor"
	scheme            = "https"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
	scrape_interval   = "60s"

	tls_config {
		insecure_skip_verify = true
	}
}

// The kube-prometheus cAdvisor drop list plus unread families that are not
// memory, CPU or pressure history. This is where most of the series budget is spent.
prometheus.relabel "cadvisor" {
	forward_to = [prometheus.remote_write.prometheus.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "container_cpu_(load_average_10s|load_d_average_10s|system_seconds_total|user_seconds_total)"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "container_fs_(io_current|io_time_seconds_total|io_time_weighted_seconds_total|reads_merged_total|reads_total|sector_reads_total|sector_writes_total|writes_merged_total|writes_total)"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "container_memory_(failures_total|mapped_file|swap)"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "container_(file_descriptors|tasks_state|threads_max|blkio_device_usage_total|last_seen|ulimits_soft)"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "container_spec.*"
		action        = "drop"
	}
	// Pod-level pseudo containers (container="") duplicate what the pod's real
	// containers already report for these families.
	rule {
		source_labels = ["__name__", "container"]
		regex         = "container_(network_tcp_usage_total|network_udp_usage_total);"
		action        = "drop"
	}
}

// Shared by kubelet /metrics, kube-controller-manager and kube-scheduler: the
// unread component-base histogram buckets and feature gates (_sum and _count stay).
prometheus.relabel "kube_components" {
	forward_to = [prometheus.remote_write.prometheus.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "kubernetes_feature_enabled"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "(rest_client|kubelet|scheduler|apiserver|go)_.*_bucket"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "(workqueue_work_duration_seconds|workqueue_queue_duration_seconds|informer_processing_latency_seconds|authentication_duration_seconds|authorization_duration_seconds|authentication_token_cache_request_duration_seconds)_bucket"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "(storage_operation_duration_seconds|volume_operation_total_seconds|csi_operations_seconds|dra_operations_duration_seconds)_bucket"
		action        = "drop"
	}
}

// ------------------------------------------------ this node: node metrics --

// node-exporter's collectors in-process, reading the host through the mounts
// values.yaml adds. Emits the same node_* series, job="node-exporter".
prometheus.exporter.unix "node" {
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/host/root"

	filesystem {
		mount_points_exclude = "^/(dev|proc|run/credentials/.+|run/containerd/.+|sys|var/lib/containerd/.+|var/lib/kubelet/.+)($|/)"
		fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|sysfs|tracefs)$"
	}
}

discovery.relabel "node" {
	targets = prometheus.exporter.unix.node.targets

	rule {
		target_label = "instance"
		replacement  = sys.env("NODE_NAME")
	}

	rule {
		target_label = "node"
		replacement  = sys.env("NODE_NAME")
	}

	// The exporter's targets arrive with job="integrations/unix", which would
	// win over the scrape's job_name; the dashboards expect node-exporter.
	rule {
		target_label = "job"
		replacement  = "node-exporter"
	}
}

prometheus.scrape "node" {
	targets         = discovery.relabel.node.output
	forward_to      = [prometheus.relabel.node.receiver]
	job_name        = "node-exporter"
	scrape_interval = "60s"
}

// Per-interface and per-CPU descriptors and NFS per-operation counters that
// Node Exporter Full does not read; the traffic, error and carrier series stay.
prometheus.relabel "node" {
	forward_to = [prometheus.remote_write.prometheus.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "node_network_(address_assign_type|carrier_changes_total|carrier_down_changes_total|carrier_up_changes_total|device_id|dormant|flags|iface_id|iface_link|iface_link_mode|info|name_assign_type|net_dev_group|protocol_type|transmit_queue_length)"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "node_cpu_(scaling_governor|frequency_min_hertz|frequency_max_hertz)"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "node_nfs_requests_total"
		action        = "drop"
	}
}

// --------------------------------------- cluster-wide: annotated pods --

// The convention: prometheus.io/scrape="true" AND prometheus.io/port are
// required; path and scheme optional. job comes from the pod's app label
// (app.kubernetes.io/name, then app, then k8s-app). Covers Flux, cert-manager,
// Cilium, Traefik, the Tailscale router and this stack's own pods.
discovery.kubernetes "pods" {
	role = "pod"
}

discovery.relabel "annotated_pods" {
	targets = discovery.kubernetes.pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_phase"]
		regex         = "Running"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scrape"]
		regex         = "true"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_annotationpresent_prometheus_io_port"]
		regex         = "true"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_init"]
		regex         = "true"
		action        = "drop"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_scheme"]
		regex         = "(https?)"
		target_label  = "__scheme__"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_annotation_prometheus_io_path"]
		regex         = "(.+)"
		target_label  = "__metrics_path__"
	}
	// Pod IP + annotated port. One pod yields one target per container port
	// before this rule and identical targets after it, which the scraper
	// deduplicates — so no container label here, it would defeat the dedup.
	rule {
		source_labels = ["__meta_kubernetes_pod_ip", "__meta_kubernetes_pod_annotation_prometheus_io_port"]
		regex         = "(.+);(\\d+)"
		replacement   = "$1:$2"
		target_label  = "__address__"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_label_app", "__meta_kubernetes_pod_label_k8s_app"]
		regex         = "([^;]+);.*|;([^;]+);.*|;;(.+)"
		replacement   = "$1$2$3"
		target_label  = "job"
	}
}

prometheus.scrape "annotated_pods" {
	targets         = discovery.relabel.annotated_pods.output
	forward_to      = [prometheus.relabel.annotated_pods.receiver]
	job_name        = "annotated-pods"
	scrape_interval = "60s"

	clustering {
		enabled = true
	}
}

// Unread internals of Cilium, Alloy, Prometheus, Loki, Grafana, Flux and
// Traefik: histogram buckets (_sum and _count stay) and per-target bookkeeping.
prometheus.relabel "annotated_pods" {
	forward_to = [prometheus.remote_write.prometheus.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "(cilium|prometheus|loki|grafana|alloy_component|go)_.*_bucket"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "(gotk_reconcile_duration_seconds|traefik_router_request_duration_seconds|remotecfg_request_duration_seconds)_bucket"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "cilium_(operator_)?hive_jobs_.*"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "prometheus_(sd_kubernetes_events_total|target_sync_length_seconds|target_interval_length_seconds)"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "(net_conntrack_dialer|alloy_fanout_mapping_store)_.*|alloy_component_graph_connection"
		action        = "drop"
	}
}

// ----------------------------------- cluster-wide: annotated Services --

// Same convention on a Service (kube-state-metrics, Hubble metrics). Without a
// port annotation the endpoint's own port is scraped.
discovery.kubernetes "endpoints" {
	role = "endpoints"
}

discovery.relabel "annotated_services" {
	targets = discovery.kubernetes.endpoints.targets

	// The endpoints role also emits every other container port of the backing
	// pod; only real endpoint ports carry endpoint metadata, and only ready ones
	// answer.
	rule {
		source_labels = ["__meta_kubernetes_endpoint_port_protocol"]
		regex         = ".+"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_endpoint_ready"]
		regex         = "true"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_service_annotation_prometheus_io_scrape"]
		regex         = "true"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_service_annotation_prometheus_io_scheme"]
		regex         = "(https?)"
		target_label  = "__scheme__"
	}

	rule {
		source_labels = ["__meta_kubernetes_service_annotation_prometheus_io_path"]
		regex         = "(.+)"
		target_label  = "__metrics_path__"
	}

	rule {
		source_labels = ["__address__", "__meta_kubernetes_service_annotation_prometheus_io_port"]
		regex         = "(.+?)(?::\\d+)?;(\\d+)"
		replacement   = "$1:$2"
		target_label  = "__address__"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_service_name"]
		target_label  = "service"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_service_label_app_kubernetes_io_name", "__meta_kubernetes_service_label_app", "__meta_kubernetes_service_label_k8s_app"]
		regex         = "([^;]+);.*|;([^;]+);.*|;;(.+)"
		replacement   = "$1$2$3"
		target_label  = "job"
	}
}

prometheus.scrape "annotated_services" {
	targets         = discovery.relabel.annotated_services.output
	forward_to      = [prometheus.relabel.annotated_services.receiver]
	job_name        = "annotated-services"
	scrape_interval = "60s"

	clustering {
		enabled = true
	}
}

// cilium-envoy's proxy statistics and Hubble's gRPC server counters, which no
// dashboard reads; the envoy pods' up and process series stay.
prometheus.relabel "annotated_services" {
	forward_to = [prometheus.remote_write.prometheus.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "envoy_.*"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "grpc_server_.*|hubble_metrics_http_handler_request_duration_seconds_bucket"
		action        = "drop"
	}
}

// -------------------------------------------- cluster-wide: kube-apiserver --

discovery.kubernetes "apiserver" {
	role = "endpoints"

	namespaces {
		names = ["default"]
	}

	selectors {
		role  = "endpoints"
		field = "metadata.name=kubernetes"
	}
}

discovery.relabel "apiserver" {
	targets = discovery.kubernetes.apiserver.targets

	rule {
		source_labels = ["__meta_kubernetes_service_name", "__meta_kubernetes_endpoint_port_name"]
		regex         = "kubernetes;https"
		action        = "keep"
	}
}

prometheus.scrape "apiserver" {
	targets           = discovery.relabel.apiserver.output
	forward_to        = [prometheus.relabel.apiserver.receiver]
	job_name          = "apiserver"
	scheme            = "https"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
	scrape_interval   = "60s"

	tls_config {
		ca_file     = "/var/run/secrets/kubernetes.io/serviceaccount/ca.crt"
		server_name = "kubernetes"
	}

	clustering {
		enabled = true
	}
}

// The apiserver's latency histograms are the single largest series source in
// a small cluster and none of the vendored dashboards read them.
prometheus.relabel "apiserver" {
	forward_to = [prometheus.remote_write.prometheus.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "apiserver_(request_duration_seconds|request_sli_duration_seconds|request_slo_duration_seconds|response_sizes|watch_events_sizes|request_body_size_bytes|admission_controller_admission_duration_seconds|admission_step_admission_duration_seconds|admission_webhook_admission_duration_seconds)_bucket"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "etcd_request_duration_seconds_bucket"
		action        = "drop"
	}

	rule {
		source_labels = ["__name__"]
		regex         = "(apiserver|rest_client|go)_.*_bucket|(workqueue_work_duration_seconds|workqueue_queue_duration_seconds|authentication_duration_seconds|authorization_duration_seconds|authentication_token_cache_request_duration_seconds)_bucket"
		action        = "drop"
	}

	// Per-resource watch-cache and list bookkeeping, and the SLI/SLO copies of
	// the request histogram; apiserver_request_total and the object counts stay.
	rule {
		source_labels = ["__name__"]
		regex         = "apiserver_(watch_cache|cache_list|storage_list|watch_list_duration_seconds|request_sli_duration_seconds|request_slo_duration_seconds)_.*|watch_cache_capacity|etcd_bookmark_total|kubernetes_feature_enabled"
		action        = "drop"
	}
}

// -------------------------------------------------- cluster-wide: Longhorn --

// longhorn-manager serves /metrics on the backend Service's port 9500; the
// chart offers only a ServiceMonitor, which needs CRDs this cluster does not
// have.
discovery.kubernetes "longhorn" {
	role = "endpoints"

	namespaces {
		names = ["longhorn-system"]
	}

	selectors {
		role  = "endpoints"
		field = "metadata.name=longhorn-backend"
	}
}

discovery.relabel "longhorn" {
	targets = discovery.kubernetes.longhorn.targets

	// The endpoints role also emits the manager's webhook ports (9502/9503),
	// which are not metrics endpoints; keep the one the Service names.
	rule {
		source_labels = ["__meta_kubernetes_endpoint_port_name"]
		regex         = "manager"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}
}

prometheus.scrape "longhorn" {
	targets         = discovery.relabel.longhorn.output
	forward_to      = [prometheus.relabel.longhorn.receiver]
	job_name        = "longhorn-manager"
	scrape_interval = "60s"

	clustering {
		enabled = true
	}
}

// The manager's controller workqueues and API client, one series set per
// controller per manager pod; the volume, node and disk series stay.
prometheus.relabel "longhorn" {
	forward_to = [prometheus.remote_write.prometheus.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "longhorn_(rest_client|workqueue)_.*"
		action        = "drop"
	}
}

// ---------------------------------- cluster-wide: control-plane components --

// Talos static pods, host network, HTTPS with authn/authz delegated to the
// apiserver; the certs are Talos-internal, hence skip-verify. Needs the
// bind-address patch in the talos role.
discovery.kubernetes "control_plane_pods" {
	role = "pod"

	namespaces {
		names = ["kube-system"]
	}

	selectors {
		role  = "pod"
		label = "tier=control-plane"
	}
}

discovery.relabel "kube_controller_manager" {
	targets = discovery.kubernetes.control_plane_pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_label_k8s_app"]
		regex         = "kube-controller-manager"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_ip"]
		regex         = "(.+)"
		replacement   = "$1:10257"
		target_label  = "__address__"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "instance"
	}
}

prometheus.scrape "kube_controller_manager" {
	targets           = discovery.relabel.kube_controller_manager.output
	forward_to        = [prometheus.relabel.kube_components.receiver]
	job_name          = "kube-controller-manager"
	scheme            = "https"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
	scrape_interval   = "60s"

	tls_config {
		insecure_skip_verify = true
	}

	clustering {
		enabled = true
	}
}

discovery.relabel "kube_scheduler" {
	targets = discovery.kubernetes.control_plane_pods.targets

	rule {
		source_labels = ["__meta_kubernetes_pod_label_k8s_app"]
		regex         = "kube-scheduler"
		action        = "keep"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_ip"]
		regex         = "(.+)"
		replacement   = "$1:10259"
		target_label  = "__address__"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "instance"
	}
}

prometheus.scrape "kube_scheduler" {
	targets           = discovery.relabel.kube_scheduler.output
	forward_to        = [prometheus.relabel.kube_components.receiver]
	job_name          = "kube-scheduler"
	scheme            = "https"
	bearer_token_file = "/var/run/secrets/kubernetes.io/serviceaccount/token"
	scrape_interval   = "60s"

	tls_config {
		insecure_skip_verify = true
	}

	clustering {
		enabled = true
	}
}

// etcd is a Talos host service, not a pod: discover it by control-plane node
// and hit the plain-HTTP metrics listener the talos role's patch opens.
discovery.kubernetes "control_plane_nodes" {
	role = "node"

	selectors {
		role  = "node"
		label = "node-role.kubernetes.io/control-plane"
	}
}

discovery.relabel "etcd" {
	targets = discovery.kubernetes.control_plane_nodes.targets

	rule {
		source_labels = ["__meta_kubernetes_node_address_InternalIP"]
		regex         = "(.+)"
		replacement   = "$1:2381"
		target_label  = "__address__"
	}

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_node_name"]
		target_label  = "instance"
	}
}

prometheus.scrape "etcd" {
	targets         = discovery.relabel.etcd.output
	forward_to      = [prometheus.relabel.etcd.receiver]
	job_name        = "etcd"
	scrape_interval = "60s"

	clustering {
		enabled = true
	}
}

// Per-method gRPC result codes and the debugging histograms; the disk, raft
// and request latency histograms stay.
prometheus.relabel "etcd" {
	forward_to = [prometheus.remote_write.prometheus.receiver]

	rule {
		source_labels = ["__name__"]
		regex         = "grpc_server_handled_total|etcd_debugging_.*"
		action        = "drop"
	}
}

// --------------------------------------------------- cluster-wide: SearXNG --

// SearXNG's /metrics needs basic auth, which the annotation-driven scrapes
// cannot carry — hence an explicit job, reading the same cluster-secrets key
// the searxng layer substitutes into settings.yml. Reading it at runtime needs
// no RBAC (the chart grants secrets cluster-wide already) and keeps envsubst
// away from this file, which has no postBuild on purpose — docs/design/searxng.md.
remote.kubernetes.secret "cluster_secrets" {
	namespace = "flux-system"
	name      = "cluster-secrets"
}

discovery.kubernetes "searxng" {
	role = "endpoints"

	namespaces {
		names = ["searxng"]
	}

	selectors {
		role  = "endpoints"
		field = "metadata.name=searxng"
	}
}

discovery.relabel "searxng" {
	targets = discovery.kubernetes.searxng.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}
}

prometheus.scrape "searxng" {
	targets         = discovery.relabel.searxng.output
	forward_to      = [prometheus.remote_write.prometheus.receiver]
	job_name        = "searxng"
	scrape_interval = "60s"

	basic_auth {
		username = "metrics"
		password = remote.kubernetes.secret.cluster_secrets.data["SEARXNG_OPEN_METRICS"]
	}

	clustering {
		enabled = true
	}
}

// -------------------------------------------- cluster-wide: Home Assistant --

// Home Assistant's /api/prometheus needs a bearer token, which the
// annotation-driven scrapes cannot carry — the same reason SearXNG gets an
// explicit job (docs/design/home-assistant.md).
discovery.kubernetes "home_assistant" {
	role = "endpoints"

	namespaces {
		names = ["home-assistant"]
	}

	selectors {
		role  = "endpoints"
		field = "metadata.name=home-assistant"
	}
}

// The endpoint address is the node's own, because the pod is hostNetwork. Label
// it as the pod anyway so the dashboard can match on the same labels as any
// other workload.
discovery.relabel "home_assistant" {
	targets = discovery.kubernetes.home_assistant.targets

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "instance"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}
}

prometheus.scrape "home_assistant" {
	targets         = discovery.relabel.home_assistant.output
	forward_to      = [prometheus.remote_write.prometheus.receiver]
	job_name        = "home-assistant"
	metrics_path    = "/api/prometheus"
	scrape_interval = "60s"

	bearer_token = remote.kubernetes.secret.cluster_secrets.data["HOME_ASSISTANT_TOKEN"]

	clustering {
		enabled = true
	}
}

// -------------------------------------------------- this node: pod logs --

discovery.kubernetes "pods_local" {
	role = "pod"

	selectors {
		role  = "pod"
		field = "spec.nodeName=" + sys.env("NODE_NAME")
	}
}

// kubelet writes /var/log/pods/<ns>_<pod>_<uid>/<container>/0.log and rotates
// at 10 MiB; the *.log glob deliberately misses the rotated 0.log.<ts> files.
discovery.relabel "pod_logs" {
	targets = discovery.kubernetes.pods_local.targets

	// Braced indices: Go's regexp expansion reads "$1_" as a group named "1_"
	// (empty), which silently drops the <ns>_<pod>_ prefix and matches nothing.
	rule {
		source_labels = ["__meta_kubernetes_namespace", "__meta_kubernetes_pod_name", "__meta_kubernetes_pod_uid", "__meta_kubernetes_pod_container_name"]
		separator     = "/"
		regex         = "(.+)/(.+)/(.+)/(.+)"
		replacement   = "/var/log/pods/${1}_${2}_${3}/${4}/*.log"
		target_label  = "__path__"
	}

	rule {
		source_labels = ["__meta_kubernetes_namespace"]
		target_label  = "namespace"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_name"]
		target_label  = "pod"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_container_name"]
		target_label  = "container"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_node_name"]
		target_label  = "node"
	}

	rule {
		source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name", "__meta_kubernetes_pod_label_app", "__meta_kubernetes_pod_label_k8s_app", "__meta_kubernetes_pod_container_name"]
		regex         = "([^;]+);.*|;([^;]+);.*|;;([^;]+);.*|;;;(.+)"
		replacement   = "$1$2$3$4"
		target_label  = "app"
	}

	rule {
		source_labels = ["namespace", "app"]
		separator     = "/"
		target_label  = "job"
	}
}

local.file_match "pod_logs" {
	path_targets = discovery.relabel.pod_logs.output
}

loki.source.file "pod_logs" {
	targets    = local.file_match.pod_logs.targets
	forward_to = [loki.process.pod_logs.receiver]
}

loki.process "pod_logs" {
	forward_to = [loki.write.loki.receiver]
	// containerd's CRI log format: timestamp, stream, flags, line. Adds the
	// stream label and puts the original timestamp on the entry.
	stage.cri { }
	// The path is already implied by namespace/pod/container.
	stage.label_drop {
		values = ["filename"]
	}
}
