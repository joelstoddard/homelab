// The gateway Alloy: syslog receiver for the hosts that cannot run an agent,
// and the scraper for the multi-target exporters, whose targets come from the
// Flux-substituted file mounted at /etc/alloy-targets. docs/design/host-monitoring.md.

// ---------------------------------------------------------------- sinks --

prometheus.remote_write "prometheus" {
	endpoint {
		url = "http://prometheus-server.monitoring.svc/api/v1/write"
	}
}

loki.write "loki" {
	endpoint {
		url = "http://loki.monitoring.svc:3100/loki/api/v1/push"
	}
}

// --------------------------------------------------------------- syslog --

// TrueNAS CORE (FreeBSD syslogd) and the ASUS router both speak BSD syslog.
// Port 1514 so the pod needs neither root nor NET_BIND_SERVICE; the syslog Service maps 514.
loki.source.syslog "lan" {
	listener {
		address       = "0.0.0.0:1514"
		protocol      = "udp"
		syslog_format = "rfc3164"
		labels        = {job = "syslog"}
	}

	listener {
		address       = "0.0.0.0:1514"
		protocol      = "tcp"
		syslog_format = "rfc3164"
		labels        = {job = "syslog"}
	}

	relabel_rules = loki.relabel.syslog.rules
	forward_to    = [loki.write.loki.receiver]
}

loki.relabel "syslog" {
	forward_to = []

	rule {
		source_labels = ["__syslog_message_hostname"]
		target_label  = "host"
	}

	rule {
		source_labels = ["__syslog_message_severity"]
		target_label  = "severity"
	}

	rule {
		source_labels = ["__syslog_message_facility"]
		target_label  = "facility"
	}

	rule {
		source_labels = ["__syslog_message_app_name"]
		target_label  = "app"
	}
}

// -------------------------------------------------------------- targets --

discovery.file "hosts" {
	files = ["/etc/alloy-targets/targets.json"]
}

// ------------------------------------------------------------------ pve --

// One exporter, four PVE APIs: the target's address becomes ?target= and the
// scrape goes to the exporter. instance stays the host name from the file.
discovery.relabel "pve" {
	targets = discovery.file.hosts.targets

	rule {
		source_labels = ["group"]
		regex         = "pve"
		action        = "keep"
	}

	rule {
		source_labels = ["__address__"]
		target_label  = "__param_target"
	}

	rule {
		target_label = "__address__"
		replacement  = "pve-exporter:9221"
	}

	rule {
		regex  = "group"
		action = "labeldrop"
	}
}

prometheus.scrape "pve" {
	targets         = discovery.relabel.pve.output
	forward_to      = [prometheus.remote_write.prometheus.receiver]
	job_name        = "pve"
	metrics_path    = "/pve"
	params          = {module = ["default"], cluster = ["1"], node = ["1"]}
	scrape_interval = "60s"
	scrape_timeout  = "30s"
}

// ------------------------------------------------------------- blackbox --

discovery.relabel "blackbox" {
	targets = discovery.file.hosts.targets

	rule {
		source_labels = ["group"]
		regex         = "probe"
		action        = "keep"
	}

	rule {
		source_labels = ["__address__"]
		target_label  = "__param_target"
	}

	rule {
		source_labels = ["module"]
		target_label  = "__param_module"
	}

	rule {
		target_label = "__address__"
		replacement  = "blackbox-exporter:9115"
	}

	// module stays: james-webb appears once per probe module and it is the only label telling them apart.
	rule {
		regex  = "group"
		action = "labeldrop"
	}
}

prometheus.scrape "blackbox" {
	targets         = discovery.relabel.blackbox.output
	forward_to      = [prometheus.remote_write.prometheus.receiver]
	job_name        = "blackbox"
	metrics_path    = "/probe"
	scrape_interval = "60s"
	scrape_timeout  = "15s"
}

// ------------------------------------------------- pihole, truenas (graphite) --

prometheus.scrape "pihole" {
	targets = [{
		__address__ = "pihole-exporter:9617",
		instance    = "pihole",
	}]
	forward_to      = [prometheus.relabel.pihole.receiver]
	job_name        = "pihole"
	scrape_interval = "60s"
}

// ekofr/pihole-exporter labels every series with the hostname it was given
// to reach the API — the LAN address from cluster-secrets, not a name.
// Rewrite it to "pihole", the value the scrape's own instance label already uses.
prometheus.relabel "pihole" {
	forward_to = [prometheus.remote_write.prometheus.receiver]

	rule {
		target_label = "hostname"
		replacement  = "pihole"
	}
}

prometheus.scrape "truenas" {
	targets = [{
		__address__ = "graphite-exporter:9108",
		instance    = "voyager",
	}]
	forward_to      = [prometheus.remote_write.prometheus.receiver]
	job_name        = "truenas"
	scrape_interval = "60s"
}
