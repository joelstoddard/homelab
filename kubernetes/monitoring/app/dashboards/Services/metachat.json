{
  "id": null,
  "uid": "homelab-metachat",
  "title": "metachat",
  "description": "Production metachat on skylab, pushed by the VPS's Alloy. Ported from metachat's deploy/observability/dashboards/metachat-overview.json.",
  "tags": [
    "metachat"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "The four asks",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 1,
      "title": "Clients registered",
      "description": "Cumulative joins, and the rate they arrive at. A join is a participant admitted to a room, not a socket opening \u2014 see the connection row for those.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "metachat_participants_joined_total",
          "legendFormat": "joined (total)"
        },
        {
          "refId": "B",
          "expr": "sum(rate(metachat_participants_left_total[$__rate_interval]))",
          "legendFormat": "leaving/sec"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Rooms generated",
      "description": "Cumulative rooms created, split by floor size.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "metachat_rooms_created_total",
          "legendFormat": "{{floor_size}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Room-with-users duration",
      "description": "How long a room held at least one participant, one observation per gathering. Only recorded when a room empties, so a long conversation shows up at its end \u2014 a flat line means nobody has left yet, not that nothing is happening.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(metachat_room_occupied_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum(rate(metachat_room_occupied_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "metachat_room_occupied_seconds_count",
          "legendFormat": "gatherings (total)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "gatherings (total)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 4,
      "title": "Links per user",
      "description": "Peer links held per participant, sampled once per far tick (1 Hz) and weighted by time in room. MAX_LINKS is 20, so p99 pinned near 20 means the cap is binding.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum(rate(metachat_participant_links_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.9, sum(rate(metachat_participant_links_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum(rate(metachat_participant_links_bucket[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        },
        {
          "refId": "D",
          "expr": "sum(rate(metachat_participant_links_sum[$__rate_interval])) / sum(rate(metachat_participant_links_count[$__rate_interval]))",
          "legendFormat": "mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "row",
      "id": 101,
      "title": "Live now",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "stat",
      "id": 5,
      "title": "Rooms",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "metachat_rooms"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "id": 6,
      "title": "Participants",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "metachat_participants"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "id": 7,
      "title": "Sockets open",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "metachat_ws_connections"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Links (gauge vs sampled mean)",
      "description": "metachat_links is the topology tick's decision, read at scrape time. During a mass disconnect it briefly overcounts, because Remove does not prune the link set until the next tick \u2014 the sampled mean does not have that problem, since it indexes by participant.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 5,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "metachat_links",
          "legendFormat": "links (gauge)"
        },
        {
          "refId": "B",
          "expr": "metachat_participants * (sum(rate(metachat_participant_links_sum[$__rate_interval])) / sum(rate(metachat_participant_links_count[$__rate_interval]))) / 2",
          "legendFormat": "links implied by the sampled mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "row",
      "id": 102,
      "title": "Server health",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 9,
      "title": "Departures by reason",
      "description": "disconnect is a socket dropping; leave is the client asking to go. A pile of disconnects with no leaves means clients are not exiting cleanly.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (reason) (rate(metachat_participants_left_total[$__rate_interval])) > 0",
          "legendFormat": "{{reason}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 10,
      "title": "Inbound frames by type",
      "description": "Only types actually seen are drawn. \"invalid\" is a frame the decoder rejected.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (type) (rate(metachat_ws_messages_received_total[$__rate_interval])) > 0",
          "legendFormat": "{{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "stacking": {
              "mode": "normal"
            }
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 11,
      "title": "Egress",
      "description": "Bytes written to client sockets. The spec's budget is the reason this is worth watching under load.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(metachat_ws_bytes_sent_total[$__rate_interval])",
          "legendFormat": "egress"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "Topology tick vs compute",
      "description": "tick includes waiting for each room's lock; compute is topology.Compute alone. They diverge when joins hold the locks, which is how you tell contention from algorithm cost. Budget is 100ms at TOPOLOGY_RATE_HZ = 10.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum(rate(metachat_topology_tick_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "tick p99"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99, sum(rate(metachat_topology_compute_seconds_bucket[$__rate_interval])) by (le))",
          "legendFormat": "compute p99"
        },
        {
          "refId": "C",
          "expr": "sum(rate(metachat_topology_tick_seconds_sum[$__rate_interval])) / sum(rate(metachat_topology_tick_seconds_count[$__rate_interval]))",
          "legendFormat": "tick mean"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "type": "timeseries",
      "id": 13,
      "title": "Back-pressure and refusals",
      "description": "overflow is a reliable send onto a full outbox, which closes that connection \u2014 it should be 0 outside a synchronised teardown. superseded is the lossy tier working as intended.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(metachat_ws_outbox_overflow_total[$__rate_interval])",
          "legendFormat": "outbox overflow"
        },
        {
          "refId": "B",
          "expr": "rate(metachat_ws_positions_superseded_total[$__rate_interval])",
          "legendFormat": "positions superseded"
        },
        {
          "refId": "C",
          "expr": "sum by (reason) (rate(metachat_ws_connections_rejected_total[$__rate_interval])) > 0",
          "legendFormat": "refused: {{reason}}"
        },
        {
          "refId": "D",
          "expr": "sum by (type) (rate(metachat_ws_messages_dropped_total[$__rate_interval])) > 0",
          "legendFormat": "rate-limited: {{type}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    }
  ],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": []
  }
}
