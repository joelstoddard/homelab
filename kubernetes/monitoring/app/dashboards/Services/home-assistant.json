{
  "id": null,
  "uid": "homelab-home-assistant",
  "title": "Home Assistant",
  "tags": ["home-assistant"],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Availability", "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
     "description": "kube-state-metrics series carry the collector's namespace, so the real one is exported_namespace.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "max(kube_pod_status_ready{exported_namespace=\"home-assistant\", condition=\"true\"})"}],
     "fieldConfig": {"defaults": {"mappings": [
       {"type": "value", "options": {"0": {"text": "Down", "color": "red", "index": 0}, "1": {"text": "Up", "color": "green", "index": 1}}}],
       "noValue": "No data"}, "overrides": []},
     "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},

    {"id": 2, "type": "stat", "title": "Restarts", "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0},
     "description": "A climbing count means the pod is crash-looping. Check the config volume and the logs panel below first.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(kube_pod_container_status_restarts_total{exported_namespace=\"home-assistant\", container=\"home-assistant\"})"}],
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [
       {"color": "green", "value": null}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}]}}, "overrides": []},
     "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}}},

    {"id": 3, "type": "stat", "title": "Uptime", "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "time() - max(container_start_time_seconds{namespace=\"home-assistant\", container=\"home-assistant\"})"}],
     "fieldConfig": {"defaults": {"unit": "s", "decimals": 0}, "overrides": []},
     "options": {"colorMode": "none", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},

    {"id": 4, "type": "stat", "title": "Config volume health", "gridPos": {"h": 4, "w": 6, "x": 18, "y": 0},
     "description": "Longhorn robustness for home-assistant-config. Every longhorn-manager reports this volume, and only the one owning it knows the real state, so max() picks the worst non-unknown value.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "max(longhorn_volume_robustness{pvc=\"home-assistant-config\", pvc_namespace=\"home-assistant\"})"}],
     "fieldConfig": {"defaults": {"mappings": [
       {"type": "value", "options": {
         "0": {"text": "Unknown", "color": "text", "index": 0},
         "1": {"text": "Healthy", "color": "green", "index": 1},
         "2": {"text": "Degraded", "color": "orange", "index": 2},
         "3": {"text": "Faulted", "color": "red", "index": 3}}}]}, "overrides": []},
     "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}}},

    {"id": 5, "type": "timeseries", "title": "Requests by status (Beyla)", "gridPos": {"h": 8, "w": 8, "x": 0, "y": 4},
     "description": "eBPF RED metrics for the pod. Home Assistant can expose a native /api/prometheus endpoint, but only after a long-lived token minted from its web UI post-install (tracked follow-up), so Beyla is the only signal today. Beyla stamps its own namespace, so the pod's is k8s_namespace_name.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (http_response_status_code) (rate({__name__=~\"http_server_request_duration_seconds_count|http_server_request_duration_count\", k8s_namespace_name=\"home-assistant\"}[$__rate_interval]))", "legendFormat": "{{http_response_status_code}}"}],
     "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}},

    {"id": 6, "type": "timeseries", "title": "Response time (Beyla)", "gridPos": {"h": 8, "w": 8, "x": 8, "y": 4},
     "description": "Quantiles over Beyla's histogram. Home Assistant runs a single asyncio event loop, so a recorder write blocking on the replicated Longhorn volume stalls requests too.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"home-assistant\"}[$__rate_interval])))", "legendFormat": "p50"},
       {"refId": "B", "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"home-assistant\"}[$__rate_interval])))", "legendFormat": "p95"},
       {"refId": "C", "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{k8s_namespace_name=\"home-assistant\"}[$__rate_interval])))", "legendFormat": "p99"}],
     "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}},

    {"id": 7, "type": "timeseries", "title": "Busiest routes (Beyla)", "gridPos": {"h": 8, "w": 8, "x": 16, "y": 4},
     "description": "This panel and the two beside it are unverified against a host-network pod: the only other host-network workloads in this cluster are collectors Beyla deliberately excludes, so expect empty data until Home Assistant is actually serving traffic.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "topk(10, sum by (http_route) (rate(http_server_request_duration_seconds_count{k8s_namespace_name=\"home-assistant\"}[$__rate_interval])))", "legendFormat": "{{http_route}}"}],
     "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}},

    {"id": 8, "type": "timeseries", "title": "CPU against limit", "gridPos": {"h": 8, "w": 6, "x": 0, "y": 12},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"home-assistant\", container=\"home-assistant\"}[$__rate_interval]))", "legendFormat": "used"},
       {"refId": "B", "expr": "max(kube_pod_container_resource_limits{exported_namespace=\"home-assistant\", resource=\"cpu\"})", "legendFormat": "limit"}],
     "fieldConfig": {"defaults": {"unit": "none", "decimals": 2}, "overrides": []}},

    {"id": 9, "type": "timeseries", "title": "CPU throttling", "gridPos": {"h": 8, "w": 6, "x": 6, "y": 12},
     "description": "Share of CFS periods throttled. The single asyncio event loop means throttling stalls automations and the frontend alike, which is why the limit is deliberately generous.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(rate(container_cpu_cfs_throttled_periods_total{namespace=\"home-assistant\", container=\"home-assistant\"}[$__rate_interval])) / clamp_min(sum(rate(container_cpu_cfs_periods_total{namespace=\"home-assistant\", container=\"home-assistant\"}[$__rate_interval])), 1)", "legendFormat": "throttled"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "thresholds": {"mode": "absolute", "steps": [
       {"color": "green", "value": null}, {"color": "yellow", "value": 0.05}, {"color": "red", "value": 0.25}]}}, "overrides": []}},

    {"id": 10, "type": "timeseries", "title": "Memory against limit", "gridPos": {"h": 8, "w": 6, "x": 12, "y": 12},
     "description": "Limits are a first guess pending a week of real use, same as the Deployment's own TODO.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "sum(container_memory_working_set_bytes{namespace=\"home-assistant\", container=\"home-assistant\"})", "legendFormat": "working set"},
       {"refId": "B", "expr": "max(kube_pod_container_resource_limits{exported_namespace=\"home-assistant\", resource=\"memory\"})", "legendFormat": "limit"}],
     "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},

    {"id": 11, "type": "timeseries", "title": "OOM kills", "gridPos": {"h": 8, "w": 6, "x": 18, "y": 12},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(increase(container_oom_events_total{namespace=\"home-assistant\"}[$__rate_interval]))", "legendFormat": "oom events"}],
     "fieldConfig": {"defaults": {"unit": "short", "min": 0}, "overrides": []}},

    {"id": 12, "type": "timeseries", "title": "Container filesystem I/O", "gridPos": {"h": 8, "w": 24, "x": 0, "y": 20},
     "description": "The config volume: the recorder database, the entity/device registries and backups. No network panel here — hostNetwork means container_network_* enumerates every interface on the node, not just this pod's, so it would report the node's whole overlay traffic as Home Assistant's.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "sum(rate(container_fs_reads_bytes_total{namespace=\"home-assistant\", container=\"home-assistant\"}[$__rate_interval]))", "legendFormat": "read"},
       {"refId": "B", "expr": "sum(rate(container_fs_writes_bytes_total{namespace=\"home-assistant\", container=\"home-assistant\"}[$__rate_interval]))", "legendFormat": "write"}],
     "fieldConfig": {"defaults": {"unit": "Bps"}, "overrides": []}},

    {"id": 13, "type": "gauge", "title": "Config volume used", "gridPos": {"h": 7, "w": 6, "x": 0, "y": 28},
     "description": "Longhorn, replicated three times. The recorder database is the steady grower.",
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "kubelet_volume_stats_used_bytes{namespace=\"home-assistant\", persistentvolumeclaim=\"home-assistant-config\"} / kubelet_volume_stats_capacity_bytes{namespace=\"home-assistant\", persistentvolumeclaim=\"home-assistant-config\"}"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1, "thresholds": {"mode": "absolute", "steps": [
       {"color": "green", "value": null}, {"color": "yellow", "value": 0.75}, {"color": "red", "value": 0.9}]}}, "overrides": []},
     "options": {"reduceOptions": {"calcs": ["lastNotNull"]}}},

    {"id": 14, "type": "timeseries", "title": "Volume usage over time", "gridPos": {"h": 7, "w": 18, "x": 6, "y": 28},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "kubelet_volume_stats_used_bytes{namespace=\"home-assistant\"}", "legendFormat": "{{persistentvolumeclaim}}"}],
     "fieldConfig": {"defaults": {"unit": "bytes"}, "overrides": []}},

    {"id": 15, "type": "logs", "title": "Logs", "gridPos": {"h": 10, "w": 24, "x": 0, "y": 35},
     "datasource": {"type": "loki", "uid": "loki"},
     "options": {"showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "dedupStrategy": "none", "enableLogDetails": true},
     "targets": [{"refId": "A", "expr": "{namespace=\"home-assistant\"}"}]}
  ]
}
