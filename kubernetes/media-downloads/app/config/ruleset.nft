# The kill switch for this pod's network namespace: everything the torrent
# client sends leaves through tailscale0 or it does not leave, and the table is
# its own so that neither side can reconcile the other away.
# See docs/design/arr-stack.md, "Inside the ruleset".
#
# Nothing here may contain a dollar sign. This file is a configMapGenerator
# input, embedded verbatim, and Flux runs envsubst over the result.

# Create-then-delete, so a retried init container converges instead of
# appending a second copy of every accept.
table inet ts-killswitch
delete table inet ts-killswitch

table inet ts-killswitch {
  chain output {
    type filter hook output priority 0; policy drop;

    # tailscaled's local API and the s6 supervision inside the LinuxServer
    # image both talk to themselves.
    oifname "lo" counter accept

    # Replies to the kubelet's probes and to Traefik's requests to the WebUI.
    ct state established ct direction reply counter accept

    # tailscaled's own marked traffic to the control plane and DERP. Necessary
    # but not sufficient: its pre-tunnel HTTPS carries no mark.
    meta mark and 0xff0000 == 0x80000 counter accept

    # Matching the outbound interface by name fails closed before tailscale0
    # exists, and stays independent of what Cilium calls the veth.
    oifname "tailscale0" counter accept

    # Cluster pod and Service CIDRs: Traefik to the WebUI, and cluster DNS.
    ip daddr 10.244.0.0/16 counter accept
    ip daddr 10.96.0.0/12 counter accept

    # The apiserver, which socket-LB has already rewritten to a node's LAN
    # address by the time this chain sees it; containerboot fatals without it.
    ip daddr 10.0.0.0/20 tcp dport 6443 counter accept

    # The bootstrap exception: tailscaled runs as root and nothing else lets it
    # reach the control plane that builds the tunnel. Last of the accepts, and
    # the torrent engine is dropped to PUID 1000 before it opens a socket.
    meta skuid 0 counter accept

    # Explicit, purely so that it counts: a chain policy carries no counter.
    counter drop
  }
}
