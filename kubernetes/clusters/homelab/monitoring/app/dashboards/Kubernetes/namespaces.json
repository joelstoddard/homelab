    {
      "type": "timeseries",
      "title": "CPU throttling",
      "description": "Share of CFS periods in which containers hit their CPU limit, per namespace, or per pod when one namespace is chosen. Sustained throttling slows the app.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (namespace, $group) (rate(container_cpu_cfs_throttled_periods_total{namespace=~\"$namespace\", container!=\"\", container!=\"POD\"}[$__rate_interval])) / sum by (namespace, $group) (rate(container_cpu_cfs_periods_total{namespace=~\"$namespace\", container!=\"\", container!=\"POD\"}[$__rate_interval])) > 0",
          "legendFormat": "{{$group}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
