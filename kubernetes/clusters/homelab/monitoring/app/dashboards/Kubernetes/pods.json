    {
      "type": "logs",
      "title": "Logs",
      "description": "The newest 500 lines from the selected pods' containers; pick one pod to read it alone. Filter with the Contains box.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=~\"$namespace\", pod=~\"$pod\"} |= \"$search\"",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "showLabels": true
      },
