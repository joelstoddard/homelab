{
  "id": null,
  "uid": "homelab-blackbox",
  "title": "Blackbox",
  "description": "Every blackbox probe at once, failing first: the NUCs, Voyager, Hubble, the Pi-hole pair and its VIP, and each Pi's Talos API, by target and module. Replaces the vendored Prometheus Blackbox Exporter (grafana.com 7587). docs/design/host-monitoring.md.",
  "tags": [
    "network"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "1m",
  "links": [
    {
      "type": "link",
      "title": "Network overview",
      "url": "/d/homelab-network-overview",
      "icon": "dashboard",
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "module",
        "label": "Module",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(probe_success{job=\"blackbox\"}, module)",
          "refId": "module"
        },
        "definition": "label_values(probe_success{job=\"blackbox\"}, module)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "target",
        "label": "Target",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(probe_success{job=\"blackbox\", module=~\"$module\"}, instance)",
          "refId": "target"
        },
        "definition": "label_values(probe_success{job=\"blackbox\", module=~\"$module\"}, instance)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Summary",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Failing",
      "description": "Probes whose last attempt failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(probe_success{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"} == 0) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Probes",
      "description": "Probes reporting, one per target and module.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(probe_success{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 3,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Targets",
      "description": "Hosts probed by at least one module. The Pis appear as their Talos API is discovered from the cluster's nodes, so a new Pi needs no edit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(count by (instance) (probe_success{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"})) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 4,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Not reporting",
      "description": "Probes seen in the last day that report nothing now: the target was dropped from the scrape, or the scraper is down. Their rows stay in the table, marked Not reporting.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(max by (instance, module) (last_over_time(probe_success{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"}[1d])) unless on (instance, module) probe_success{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"}) or vector(0)",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 5,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Slowest probe",
      "description": "The probe that took longest on its last attempt.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(1, max by (instance, module) (probe_duration_seconds{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"}))",
          "instant": true,
          "legendFormat": "{{instance}} {{module}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 6,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Earliest certificate expiry",
      "description": "Time left on the TLS certificate closest to expiring, across the HTTPS probes. Orange under 21 days, red under 7.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(1, max by (instance) (probe_ssl_earliest_cert_expiry{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"}) - time())",
          "instant": true,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dtdurations",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 604800
              },
              {
                "color": "green",
                "value": 1814400
              }
            ]
          },
          "noValue": "No HTTPS probe selected"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "center",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 7,
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      }
    },
    {
      "type": "row",
      "title": "Probes",
      "collapsed": false,
      "panels": [],
      "id": 8,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "table",
      "title": "Every probe, worst first",
      "description": "One row per target and module, failing and silent probes first. Success is the share of attempts that passed over 24 hours. HTTP status is filled for http_2xx probes only. Click a target to open its own dashboard or to show only it here.",
      "datasource": {
        "type": "datasource",
        "uid": "-- Mixed --"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(label_replace(label_replace(max by (instance, module) (probe_success{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"}) or on (instance, module) (max by (instance, module) (last_over_time(probe_success{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"}[1d])) * 0 - 1), \"dashboard\", \"homelab-host-$1\", \"instance\", \"(.*)\"), \"dashboard\", \"homelab-router\", \"instance\", \"hubble\"), \"dashboard\", \"homelab-pihole\", \"instance\", \"pihole-.*\")",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "label_replace(label_replace(label_replace(max by (instance, module) (avg_over_time(probe_success{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"}[24h])), \"dashboard\", \"homelab-host-$1\", \"instance\", \"(.*)\"), \"dashboard\", \"homelab-router\", \"instance\", \"hubble\"), \"dashboard\", \"homelab-pihole\", \"instance\", \"pihole-.*\")",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "C",
          "expr": "label_replace(label_replace(label_replace(max by (instance, module) (probe_duration_seconds{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"}), \"dashboard\", \"homelab-host-$1\", \"instance\", \"(.*)\"), \"dashboard\", \"homelab-router\", \"instance\", \"hubble\"), \"dashboard\", \"homelab-pihole\", \"instance\", \"pihole-.*\")",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "D",
          "expr": "label_replace(label_replace(label_replace(max by (instance, module) (probe_http_status_code{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"}), \"dashboard\", \"homelab-host-$1\", \"instance\", \"(.*)\"), \"dashboard\", \"homelab-router\", \"instance\", \"hubble\"), \"dashboard\", \"homelab-pihole\", \"instance\", \"pihole-.*\")",
          "format": "table",
          "instant": true,
          "range": false,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "refId": "NetBoxDevices",
          "datasource": {
            "type": "netboxlabs-netbox-datasource",
            "uid": "netbox"
          },
          "queryType": "objects",
          "objectType": "dcim/devices",
          "fields": [
            "name",
            "role",
            "status",
            "description",
            "display_url"
          ],
          "joinKeys": [
            {
              "source": "name",
              "output": "instance",
              "transform": "lower"
            }
          ],
          "limit": 500
        },
        {
          "refId": "NetBoxVMs",
          "datasource": {
            "type": "netboxlabs-netbox-datasource",
            "uid": "netbox"
          },
          "queryType": "objects",
          "objectType": "virtualization/virtual-machines",
          "fields": [
            "name",
            "role",
            "status",
            "description",
            "display_url"
          ],
          "joinKeys": [
            {
              "source": "name",
              "output": "instance",
              "transform": "lower"
            }
          ],
          "limit": 500
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {},
          "filter": {
            "id": "byRefId",
            "options": "/^(?:A|B|C|D)$/"
          }
        },
        {
          "id": "merge",
          "options": {},
          "filter": {
            "id": "byRefId",
            "options": "/^(?:NetBoxDevices|NetBoxVMs)$/"
          }
        },
        {
          "id": "joinByField",
          "options": {
            "byField": "instance",
            "mode": "outerTabular"
          }
        },
        {
          "id": "renameByRegex",
          "options": {
            "regex": "^(.+) netbox_[a-z_]+$",
            "renamePattern": "$1"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "instance": 0,
              "module": 5,
              "Value #A": 6,
              "Value #B": 7,
              "Value #C": 8,
              "Value #D": 9,
              "dashboard": 10,
              "name": 1,
              "role": 2,
              "status": 3,
              "description": 4
            },
            "renameByName": {
              "instance": "Target",
              "module": "Module",
              "Value #A": "State",
              "Value #B": "Success, 24 h",
              "Value #C": "Duration",
              "Value #D": "HTTP status",
              "name": "NetBox",
              "role": "NetBox role",
              "status": "NetBox status",
              "description": "NetBox description"
            }
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "State",
                "config": {
                  "id": "isNull",
                  "options": {}
                }
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "State"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "-1": {
                        "text": "Not reporting",
                        "color": "orange"
                      },
                      "0": {
                        "text": "Down",
                        "color": "red"
                      },
                      "1": {
                        "text": "Up",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Success, 24 h"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 0.99
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "HTTP status"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "dashboard"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Target"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Open ${__value.raw}",
                    "url": "/d/${__data.fields.dashboard}?${__url_time_range}"
                  },
                  {
                    "title": "Show only ${__value.raw} here",
                    "url": "/d/homelab-blackbox?var-target=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "NetBox"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "not in NetBox"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "display_url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "State",
            "desc": false
          }
        ]
      },
      "id": 9,
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "row",
      "title": "Status over time",
      "collapsed": false,
      "panels": [],
      "id": 10,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 22
      }
    },
    {
      "type": "state-timeline",
      "title": "Status by probe",
      "description": "Each probe's result over time. A gap is a probe that was not reporting.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance, module) (probe_success{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"})",
          "legendFormat": "{{instance}} {{module}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red"
                },
                "1": {
                  "text": "Up",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "showLegend": false
        }
      },
      "id": 11,
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 23
      }
    },
    {
      "type": "row",
      "title": "Timing",
      "collapsed": false,
      "panels": [],
      "id": 12,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 41
      }
    },
    {
      "type": "timeseries",
      "title": "Probe duration",
      "description": "Wall time of each probe, connection and answer included.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (instance, module) (probe_duration_seconds{job=\"blackbox\", module=~\"$module\", instance=~\"$target\"})",
          "legendFormat": "{{instance}} {{module}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 13,
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 42
      }
    },
    {
      "type": "timeseries",
      "title": "DNS query time",
