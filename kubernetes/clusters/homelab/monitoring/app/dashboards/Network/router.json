        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      }
    },
    {
      "type": "logs",
      "title": "Router syslog",
      "description": "The router's syslog, received by the cluster's syslog receiver (host label hubble). Filter with the Contains box.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{job=\"syslog\", host=\"hubble\"} |= \"$search\""
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "id": 14,
      "gridPos": {
        "h": 12,
