        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (friendly_name) (increase(homeassistant_sensor_data_size_gb{job=\"home-assistant\",friendly_name=~\"Router (Download|Upload)\"}[1d]))",
          "legendFormat": "{{friendly_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "decgbytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "description": "Increase of the router's running totals over the trailing day. The totals reset when the router reboots; increase() absorbs the reset."
    },
