    {
      "type": "stat",
      "title": "LANCache hit ratio",
      "description": "Share of cacheable game-download requests served from the cache over the time range. Reads None while nobody downloads.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({namespace=\"lancache\", container=\"access-log\"} | json upstream_cache_status | upstream_cache_status=\"HIT\" [$__range])) / sum(count_over_time({namespace=\"lancache\", container=\"access-log\"} | json upstream_cache_status | upstream_cache_status!=\"\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 1,
          "noValue": "None"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
