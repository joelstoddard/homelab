    {
      "type": "timeseries",
      "title": "DNS queries",
      "description": "Queries per second into the Pi-hole pair and into BIND (Bind9 and lancache-dns).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (hostname) (pihole_request_rate)",
          "legendFormat": "Pi-hole {{hostname}}"
        },
        {
          "refId": "B",
          "expr": "sum by (instance) (rate(bind_incoming_queries_total[$__rate_interval]))",
          "legendFormat": "BIND {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 7,
      "gridPos": {
