    },
    {
      "type": "timeseries",
      "title": "Responses by status class",
      "description": "Responses per second across every entrypoint, by status class. 404 is mostly requests for a host no route matches.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (class) (label_replace(rate(traefik_entrypoint_requests_total[$__rate_interval]), \"class\", \"$1\", \"code\", \"([0-9]).*\"))",
          "legendFormat": "{{class}}xx"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
