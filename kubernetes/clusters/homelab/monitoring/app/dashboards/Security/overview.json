      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (protocol) (rate(hubble_drop_total{reason=~\"POLICY_DENIED|POLICY_DENY\"}[$__rate_interval])) > 0",
          "legendFormat": "{{protocol}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "pps",
