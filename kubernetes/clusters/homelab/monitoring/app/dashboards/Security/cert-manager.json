    },
    {
      "type": "stat",
      "title": "ACME non-2xx",
      "description": "ACME responses outside 2xx over the dashboard's time range; Let's Encrypt answers 4xx for a rejected order or a rate limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(certmanager_http_acme_client_request_count{status!~\"2..\"}[$__range])) or vector(0)",
