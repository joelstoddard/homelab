    {
      "type": "row",
      "title": "ACME",
      "collapsed": false,
      "panels": [],
      "id": 16,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      }
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "description": "ACME requests the controller sent in each interval, by HTTP status.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (increase(certmanager_http_acme_client_request_count[$__rate_interval]))",
          "legendFormat": "{{status}}"
        }
