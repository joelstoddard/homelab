    {
      "type": "row",
      "title": "Certificates",
      "collapsed": false,
      "panels": [],
      "id": 10,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      }
    },
    {
      "type": "table",
      "title": "Certificates, soonest expiry first",
      "description": "One row per certificate. Days to expiry and to renewal are measured now; a negative renewal means it is overdue. Click a name to show only that certificate below.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (name, exported_namespace, issuer_name) ((certmanager_certificate_expiration_timestamp_seconds{name=~\"$certificate\"} - time()) / 86400)",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "B",
          "expr": "max by (name, exported_namespace, issuer_name) ((certmanager_certificate_renewal_timestamp_seconds{name=~\"$certificate\"} - time()) / 86400)",
          "format": "table",
          "instant": true,
          "range": false
        },
        {
          "refId": "C",
          "expr": "max by (name, exported_namespace, issuer_name) (certmanager_certificate_ready_status{condition=\"True\", name=~\"$certificate\"})",
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "name": 0,
              "exported_namespace": 1,
              "issuer_name": 2,
              "Value #C": 3,
              "Value #A": 4,
              "Value #B": 5
            },
            "renameByName": {
              "name": "Certificate",
              "exported_namespace": "Namespace",
              "issuer_name": "Issuer",
              "Value #A": "Days to expiry",
              "Value #B": "Days to renewal",
              "Value #C": "Ready"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Days to expiry"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 7
                    },
                    {
                      "color": "green",
                      "value": 21
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Days to renewal"
            },
            "properties": [
              {
                "id": "unit",
                "value": "d"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 0
                    }
                  ]
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Ready"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "1": {
                        "text": "Ready",
                        "color": "green",
                        "index": 0
                      },
                      "0": {
                        "text": "Not ready",
                        "color": "red",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Certificate"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Show only ${__value.raw} here",
                    "url": "/d/homelab-cert-manager?var-certificate=${__value.raw}&${__url_time_range}"
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "Days to expiry",
            "desc": false
          }
        ]
      },
      "id": 11,
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Days to expiry",
      "description": "Days until each certificate's not-after date. The lines mark 7 and 21 days.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(certmanager_certificate_expiration_timestamp_seconds{name=~\"$certificate\"} - time()) / 86400",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 7
              },
              {
                "color": "green",
                "value": 21
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      }
    },
    {
      "type": "timeseries",
      "title": "Days to renewal",
      "description": "Days until cert-manager starts renewing each certificate (by default two thirds through its lifetime). Below zero means the renewal is overdue.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(certmanager_certificate_renewal_timestamp_seconds{name=~\"$certificate\"} - time()) / 86400",
          "legendFormat": "{{name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "custom": {
            "drawStyle": "line",
