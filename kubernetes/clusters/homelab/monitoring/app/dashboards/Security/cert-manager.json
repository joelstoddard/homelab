    {
      "type": "stat",
      "title": "ACME requests",
      "description": "Requests to the ACME server over the dashboard's time range.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(certmanager_http_acme_client_request_count[$__range])) or vector(0)",
