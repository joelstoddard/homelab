{
  "id": null,
  "uid": "homelab-bentopdf",
  "title": "BentoPDF",
  "tags": [
    "bentopdf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(kube_pod_status_ready{namespace=\"bentopdf\", condition=\"true\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Restarts",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "description": "nginx reads its config once at startup and BentoPDF holds no state, so a restart costs nothing but a rising count without a release is worth a look.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"bentopdf\", container=\"bentopdf\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(container_start_time_seconds{namespace=\"bentopdf\", container=\"bentopdf\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Request rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "description": "BentoPDF serves no metrics of its own, so every request panel here comes from Traefik and counts only requests that arrive through the ingress.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"bentopdf-bentopdf-.*\"}[$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "description": "Sustained 4xx here is the bentopdf-auth middleware refusing, not BentoPDF.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(traefik_service_requests_total{service=~\"bentopdf-bentopdf-.*\"}[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Response time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "description": "Static files only: the PDF work runs in the browser, so latency is file size over the link, never processing.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"bentopdf-bentopdf-.*\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"bentopdf-bentopdf-.*\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"bentopdf-bentopdf-.*\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU against limit",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"bentopdf\", container=\"bentopdf\"}[$__rate_interval]))",
          "legendFormat": "used"
        },
        {
          "refId": "B",
          "expr": "max(kube_pod_container_resource_limits{namespace=\"bentopdf\", resource=\"cpu\"})",
          "legendFormat": "limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory against limit",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "description": "nginx serving static files; 3 MiB at rest when deployed.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(container_memory_working_set_bytes{namespace=\"bentopdf\", container=\"bentopdf\"})",
          "legendFormat": "working set"
        },
        {
          "refId": "B",
          "expr": "max(kube_pod_container_resource_limits{namespace=\"bentopdf\", resource=\"memory\"})",
          "legendFormat": "limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Network throughput",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "description": "Mostly transmit: the app's JavaScript and assets on each first visit. The advanced tools' WASM comes from jsDelivr and never crosses this pod.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"bentopdf\"}[$__rate_interval]))",
          "legendFormat": "transmit"
        },
        {
          "refId": "B",
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"bentopdf\"}[$__rate_interval]))",
          "legendFormat": "receive"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Pages opened by tool",
      "id": 13,
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "description": "From Traefik's access log, one line per page load: each BentoPDF tool is its own page, so this counts tools opened, not documents processed. Documents never leave the browser.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (count_over_time({namespace=\"traefik\", container=\"traefik\"} |= \"bentopdf.\" | json RequestHost, RequestPath, DownstreamStatus | RequestHost =~ \"bentopdf[.].+\" | line_format \"{{.RequestPath}}\" | regexp \"^/(?P<tool>[a-z0-9-]+)(\\\\.html)?/?$\" | tool != \"\" [$__auto]))",
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "OOM kills",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "description": "The NUCs are oversubscribed and have OOM-killed workloads before, which is why this is here for a pod that should never need it.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(container_oom_events_total{namespace=\"bentopdf\"}[$__rate_interval]))",
          "legendFormat": "oom kills"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"bentopdf\"}"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Flux",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "flux"
          ],
          "matchAny": true,
          "limit": 100
        }
      },
      {
        "name": "NetBox",
        "datasource": {
          "type": "netboxlabs-netbox-datasource",
          "uid": "netbox"
        },
        "enable": true,
        "iconColor": "blue",
        "target": {
          "refId": "Anno",
          "queryType": "annotations"
        }
      },
      {
        "name": "Operator",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "type": "tags",
          "tags": [
            "operator"
          ],
          "matchAny": true,
          "limit": 100
        }
      },
      {
        "name": "Proxmox",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "yellow",
        "target": {
          "type": "tags",
          "tags": [
            "proxmox"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  }
}
