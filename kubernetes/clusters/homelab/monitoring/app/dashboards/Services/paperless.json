{
  "id": null,
  "uid": "homelab-paperless",
  "title": "Paperless-ngx",
  "tags": [
    "paperless"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Availability",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(kube_deployment_status_replicas_available{namespace=\"paperless\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Down",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Up",
                  "color": "green",
                  "index": 1
                }
              }
            }
          ],
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Up only when Paperless and its Valkey broker both have a ready replica."
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Restarts",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "description": "paperless and valkey. Paperless migrates and checks its SQLite database at start, so a crash loop after an upgrade is usually a failed migration: read its logs.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"paperless\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - max(container_start_time_seconds{namespace=\"paperless\", container=\"paperless\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Request rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "description": "Requests through the ingress: the UI, uploads and phone-app API calls. Paperless exports no metrics.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"paperless-paperless-.*\"}[$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "No data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Requests by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "description": "Paperless has its own login and API tokens, no auth Middleware, so 4xx is the app's own answer.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(traefik_service_requests_total{service=~\"paperless-paperless-.*\"}[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Response time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "description": "Pages and API calls. OCR runs in Celery inside the same pod, never in a request.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"paperless-paperless-.*\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"paperless-paperless-.*\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"paperless-paperless-.*\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU against limit",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"paperless\", container!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{container}}"
        },
        {
          "refId": "B",
          "expr": "max by (container) (kube_pod_container_resource_limits{namespace=\"paperless\", resource=\"cpu\"})",
          "legendFormat": "{{container}} limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "description": "Per container. Paperless's bursts are OCR: each document is rendered and read by Tesseract."
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Memory against limit",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "description": "Per container. OCR of a large scan is the peak; limits are a first guess until a week of real use.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"paperless\", container!=\"\"})",
          "legendFormat": "{{container}}"
        },
        {
          "refId": "B",
          "expr": "max by (container) (kube_pod_container_resource_limits{namespace=\"paperless\", resource=\"memory\"})",
          "legendFormat": "{{container}} limit"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Network throughput",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "description": "Mostly the NFS traffic to Voyager (originals and archive) plus uploads; the consume folder is polled every 30 s.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"paperless\"}[$__rate_interval]))",
          "legendFormat": "transmit"
        },
        {
          "refId": "B",
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"paperless\"}[$__rate_interval]))",
          "legendFormat": "receive"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "OOM kills",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "description": "An OOM kill mid-OCR leaves the document in the consume folder to be retried on the next poll.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (increase(container_oom_events_total{namespace=\"paperless\"}[$__rate_interval]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "logs",
      "title": "Logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"paperless\"}"
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Flux",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "flux"
          ],
          "matchAny": true,
          "limit": 100
        }
      },
      {
        "name": "NetBox",
        "datasource": {
          "type": "netboxlabs-netbox-datasource",
          "uid": "netbox"
        },
        "enable": true,
        "iconColor": "blue",
        "target": {
          "refId": "Anno",
          "queryType": "annotations"
        }
      },
      {
        "name": "Operator",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "type": "tags",
          "tags": [
            "operator"
          ],
          "matchAny": true,
          "limit": 100
        }
      },
      {
        "name": "Proxmox",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "yellow",
        "target": {
          "type": "tags",
          "tags": [
            "proxmox"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  }
}
