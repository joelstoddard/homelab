{
  "id": null,
  "uid": "homelab-it-tools",
  "title": "IT-Tools",
  "tags": [
    "it-tools"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "tool",
        "label": "Tool",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "query": "app,net,pdf,cors,bridge",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": false,
            "text": "app",
            "value": "app"
          },
          {
            "selected": false,
            "text": "net",
            "value": "net"
          },
          {
            "selected": false,
            "text": "pdf",
            "value": "pdf"
          },
          {
            "selected": false,
            "text": "cors",
            "value": "cors"
          },
          {
            "selected": false,
            "text": "bridge",
            "value": "bridge"
          }
        ]
      },
      {
        "name": "container",
        "label": "Container",
        "type": "custom",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "query": "it-tools,network-utils,htmltopdf,cors-anywhere,tcp-udp-bridge",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [
          {
            "selected": false,
            "text": "it-tools",
            "value": "it-tools"
          },
          {
            "selected": false,
            "text": "network-utils",
            "value": "network-utils"
          },
          {
            "selected": false,
            "text": "htmltopdf",
            "value": "htmltopdf"
          },
          {
            "selected": false,
            "text": "cors-anywhere",
            "value": "cors-anywhere"
          },
          {
            "selected": false,
            "text": "tcp-udp-bridge",
            "value": "tcp-udp-bridge"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Ready workloads",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "description": "Deployments with an available replica, out of five: the app and four helpers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "count(kube_deployment_status_replicas_available{namespace=\"it-tools\"} > 0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 5
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 1
    },
    {
      "type": "stat",
      "title": "Restarts",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "description": "Container restarts across all five workloads since their pods started.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(kube_pod_container_status_restarts_total{namespace=\"it-tools\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 2
    },
    {
      "type": "stat",
      "title": "Request rate",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "description": "Every route on the hostname: the app and the /svc/* helpers.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(traefik_service_requests_total{service=~\"it-tools-it-tools-.*\"}[$__rate_interval]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "unit": "reqps"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 3
    },
    {
      "type": "stat",
      "title": "Helper 5xx",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "description": "5xx answers in the selected range. A helper that is down shows here before Availability: Traefik answers 503 while the pod restarts.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(traefik_service_requests_total{service=~\"it-tools-it-tools-.*\", code=~\"5..\"}[$__range])) or vector(0)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "No data",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "id": 4
    },
    {
      "type": "timeseries",
      "title": "Requests by status",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "description": "Sustained 401 is the it-tools-auth middleware refusing. A 404 on /svc/* is a cross-site request: those rules need Sec-Fetch-Site same-origin, so it fell through to the app.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (code) (rate(traefik_service_requests_total{service=~\"it-tools-it-tools-.*\"}[$__rate_interval]))",
          "legendFormat": "{{code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "id": 5
    },
    {
      "type": "timeseries",
      "title": "Response time",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "description": "All routes together. HTML to PDF dominates the tail: Chromium loads the whole target page.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"it-tools-it-tools-.*\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"it-tools-it-tools-.*\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(traefik_service_request_duration_seconds_bucket{service=~\"it-tools-it-tools-.*\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "id": 6
    },
    {
      "type": "timeseries",
      "title": "Requests by tool",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "description": "From Traefik's access log, because the helpers export no metrics. net is the network tools, pdf HTML to PDF, cors the short-URL expander and link downloader, bridge the port tester.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool) (count_over_time({namespace=\"traefik\", container=\"traefik\"} |= \"it-tools.\" | json RequestHost, RequestPath, DownstreamStatus, Duration | RequestHost =~ \"it-tools[.].+\" | line_format \"{{.RequestPath}}\" | regexp \"^/svc/(?P<tool>[a-z]+)\" | label_format tool=`{{ or .tool \"app\" }}` [$__auto]))",
          "legendFormat": "{{tool}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 30
          }
        },
        "overrides": []
      },
      "id": 7
    },
    {
      "type": "timeseries",
      "title": "Errors by tool",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "description": "5xx answers per tool. cors 4xx are the target site's own answers, so only 5xx show here.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tool, DownstreamStatus) (count_over_time({namespace=\"traefik\", container=\"traefik\"} |= \"it-tools.\" | json RequestHost, RequestPath, DownstreamStatus, Duration | RequestHost =~ \"it-tools[.].+\" | line_format \"{{.RequestPath}}\" | regexp \"^/svc/(?P<tool>[a-z]+)\" | label_format tool=`{{ or .tool \"app\" }}` | DownstreamStatus >= 500 [$__auto]))",
          "legendFormat": "{{tool}} {{DownstreamStatus}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 8
    },
    {
      "type": "timeseries",
      "title": "CPU by workload",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 20
      },
      "description": "Limits: htmltopdf 1 core, network-utils 0.5, the rest 0.2.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (rate(container_cpu_usage_seconds_total{namespace=\"it-tools\", container!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cores"
        },
        "overrides": []
      },
      "id": 9
    },
    {
      "type": "timeseries",
      "title": "Memory by workload",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 20
      },
      "description": "Limits: htmltopdf 1 GiB (Chromium), network-utils and cors-anywhere 256 MiB, the app and the bridge 128 MiB.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (container_memory_working_set_bytes{namespace=\"it-tools\", container!=\"\"})",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "id": 10
    },
    {
      "type": "timeseries",
      "title": "Network throughput",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 20
      },
      "description": "The helpers' traffic to the sites and hosts they reach, plus the app's static files.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_network_transmit_bytes_total{namespace=\"it-tools\"}[$__rate_interval]))",
          "legendFormat": "transmit"
        },
        {
          "refId": "B",
          "expr": "sum(rate(container_network_receive_bytes_total{namespace=\"it-tools\"}[$__rate_interval]))",
          "legendFormat": "receive"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps"
        },
        "overrides": []
      },
      "id": 11
    },
    {
      "type": "timeseries",
      "title": "OOM kills",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "description": "htmltopdf is the one to watch: a heavy page can push Chromium past its limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (container) (increase(container_oom_events_total{namespace=\"it-tools\"}[$__rate_interval]))",
          "legendFormat": "{{container}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "id": 12
    },
    {
      "type": "logs",
      "title": "Requests (Traefik access log)",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "description": "cors-anywhere and the bridge log nothing per request, so this is their only request log. Query strings are dropped by Traefik.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"traefik\", container=\"traefik\"} |= \"it-tools.\" | json RequestHost, RequestPath, DownstreamStatus, Duration | RequestHost =~ \"it-tools[.].+\" | line_format \"{{.RequestPath}}\" | regexp \"^/svc/(?P<tool>[a-z]+)\" | label_format tool=`{{ or .tool \"app\" }}` | tool =~ \"$tool\" | line_format \"{{.DownstreamStatus}} {{.tool}} {{.RequestPath}} {{.Duration}}ns\""
        }
      ],
      "id": 13
    },
    {
      "type": "logs",
      "title": "Container logs",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 44
      },
      "description": "network-utils logs every request; htmltopdf logs failures; the others log only at start.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{namespace=\"it-tools\", container=~\"$container\"}"
        }
      ],
      "id": 14
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Flux",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "purple",
        "target": {
          "type": "tags",
          "tags": [
            "flux"
          ],
          "matchAny": true,
          "limit": 100
        }
      },
      {
        "name": "NetBox",
        "datasource": {
          "type": "netboxlabs-netbox-datasource",
          "uid": "netbox"
        },
        "enable": true,
        "iconColor": "blue",
        "target": {
          "refId": "Anno",
          "queryType": "annotations"
        }
      },
      {
        "name": "Operator",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "orange",
        "target": {
          "type": "tags",
          "tags": [
            "operator"
          ],
          "matchAny": true,
          "limit": 100
        }
      },
      {
        "name": "Proxmox",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "iconColor": "yellow",
        "target": {
          "type": "tags",
          "tags": [
            "proxmox"
          ],
          "matchAny": true,
          "limit": 100
        }
      }
    ]
  }
}
