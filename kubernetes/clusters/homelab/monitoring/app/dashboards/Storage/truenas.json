{
  "id": null,
  "uid": "homelab-truenas",
  "title": "TrueNAS",
  "description": "The Voyager pool as storage: space, datasets, disk I/O and temperature, ZFS ARC and NFS. The host itself (CPU, memory, network, syslog) is on Hosts / Voyager. From its collectd Graphite stream (job=\"truenas\", names servers_Voyager_local_*). The names are CORE's; a move to SCALE changes them. docs/design/host-monitoring.md.",
  "tags": [
    "storage"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "links": [
    {
      "type": "link",
      "title": "Storage overview",
      "url": "/d/homelab-storage-overview",
      "icon": "dashboard"
    },
    {
      "type": "link",
      "title": "Voyager host",
      "url": "/d/homelab-host-voyager",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Pool",
      "collapsed": false,
      "panels": [],
      "id": 1,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "title": "Pool used",
      "description": "Space referenced by every dataset against that plus the pool's free space. Snapshots are not counted, so the real figure is higher.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum({__name__=~\"servers_Voyager_local_df_mnt_Voyager(_.+)?_df_complex_used\"}) / (sum({__name__=~\"servers_Voyager_local_df_mnt_Voyager(_.+)?_df_complex_used\"}) + sum(servers_Voyager_local_df_mnt_Voyager_df_complex_free))",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "id": 2,
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "stat",
      "title": "Pool free",
      "description": "Free space in the Voyager pool.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "servers_Voyager_local_df_mnt_Voyager_df_complex_free",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
