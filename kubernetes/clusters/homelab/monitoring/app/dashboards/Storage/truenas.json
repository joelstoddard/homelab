    {
      "type": "timeseries",
      "title": "CPU",
      "description": "Share of CPU time by mode, averaged across cores.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * servers_Voyager_local_aggregation_cpu_average_cpu_user / (servers_Voyager_local_aggregation_cpu_average_cpu_idle + servers_Voyager_local_aggregation_cpu_average_cpu_interrupt + servers_Voyager_local_aggregation_cpu_average_cpu_nice + servers_Voyager_local_aggregation_cpu_average_cpu_system + servers_Voyager_local_aggregation_cpu_average_cpu_user)",
          "legendFormat": "user"
        },
        {
          "refId": "B",
          "expr": "100 * servers_Voyager_local_aggregation_cpu_average_cpu_system / (servers_Voyager_local_aggregation_cpu_average_cpu_idle + servers_Voyager_local_aggregation_cpu_average_cpu_interrupt + servers_Voyager_local_aggregation_cpu_average_cpu_nice + servers_Voyager_local_aggregation_cpu_average_cpu_system + servers_Voyager_local_aggregation_cpu_average_cpu_user)",
          "legendFormat": "system"
        },
        {
          "refId": "C",
          "expr": "100 * servers_Voyager_local_aggregation_cpu_average_cpu_interrupt / (servers_Voyager_local_aggregation_cpu_average_cpu_idle + servers_Voyager_local_aggregation_cpu_average_cpu_interrupt + servers_Voyager_local_aggregation_cpu_average_cpu_nice + servers_Voyager_local_aggregation_cpu_average_cpu_system + servers_Voyager_local_aggregation_cpu_average_cpu_user)",
          "legendFormat": "interrupt"
        },
        {
