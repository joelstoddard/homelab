    {
      "type": "timeseries",
      "title": "Space used by dataset",
      "description": "Space each dataset references, largest ten.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, label_replace({__name__=~\"servers_Voyager_local_df_mnt_Voyager_.+_df_complex_used\"}, \"dataset\", \"$1\", \"__name__\", \"servers_Voyager_local_df_mnt_Voyager_(.+)_df_complex_used\"))",
          "legendFormat": "{{dataset}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
