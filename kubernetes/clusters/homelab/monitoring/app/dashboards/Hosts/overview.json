{
  "id": null,
  "uid": "homelab-hosts-overview",
  "title": "Hosts overview",
  "description": "Every physical host side by side (NUCs, Pis, Voyager and the router Hubble), the Proxmox cluster's guests, and links to each host. docs/design/host-monitoring.md.",
  "tags": [
    "hosts"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "links": [
    {
      "type": "dashboards",
      "title": "Hosts",
      "tags": [
        "hosts"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true
    },
    {
      "type": "link",
      "title": "Voyager (TrueNAS)",
      "url": "/d/homelab-host-voyager",
      "icon": "dashboard"
    },
    {
      "type": "link",
      "title": "Hubble (router)",
      "url": "/d/homelab-router",
      "icon": "dashboard"
    },
    {
      "type": "link",
      "title": "NetBox intent vs reality",
      "url": "/d/homelab-netbox",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "table",
      "title": "Hosts",
      "id": 1,
      "description": "One row per physical host: the four Proxmox NUCs, the eight Talos Pis, Voyager (TrueNAS) and Hubble (the router). Voyager's Root disk is its pool. SMART, drive wear and power are blank where a host does not report them. Click a host for its dashboard.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "U",
          "expr": "max by (instance) (up{job=\"node-exporter\", instance!~\"k8s-.*\"}) or max by (instance) (max_over_time(up{job=\"node-exporter\", instance!~\"k8s-.*\"}[1d])) * 0 or label_replace(count(servers_Voyager_local_uptime_uptime) > bool 0 or count(max_over_time(servers_Voyager_local_uptime_uptime[1d])) * 0, \"instance\", \"voyager\", \"\", \"\") or label_replace(max(homeassistant_entity_available{job=\"home-assistant\", friendly_name=\"Router Uptime\"}) or max(max_over_time(homeassistant_entity_available{job=\"home-assistant\", friendly_name=\"Router Uptime\"}[1d])) * 0, \"instance\", \"hubble\", \"\", \"\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "A",
          "expr": "max by (instance) (time() - node_boot_time_seconds{job=\"node-exporter\"} and on (instance) group by (instance) (node_boot_time_seconds{job=\"node-exporter\", instance!~\"k8s-.*\"})) or label_replace(max(servers_Voyager_local_uptime_uptime), \"instance\", \"voyager\", \"\", \"\") or label_replace(max(homeassistant_sensor_duration_s{job=\"home-assistant\", friendly_name=\"Router Uptime\"}), \"instance\", \"hubble\", \"\", \"\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max by (instance) (100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{job=\"node-exporter\", mode=\"idle\"}[5m]))) and on (instance) group by (instance) (node_boot_time_seconds{job=\"node-exporter\", instance!~\"k8s-.*\"})) or label_replace(max(100 * (1 - servers_Voyager_local_aggregation_cpu_average_cpu_idle / (servers_Voyager_local_aggregation_cpu_average_cpu_idle + servers_Voyager_local_aggregation_cpu_average_cpu_interrupt + servers_Voyager_local_aggregation_cpu_average_cpu_nice + servers_Voyager_local_aggregation_cpu_average_cpu_system + servers_Voyager_local_aggregation_cpu_average_cpu_user))), \"instance\", \"voyager\", \"\", \"\") or label_replace(max(homeassistant_sensor_unit_percent{job=\"home-assistant\", friendly_name=\"Router CPU usage\"}), \"instance\", \"hubble\", \"\", \"\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max by (instance) (100 * (1 - node_memory_MemAvailable_bytes{job=\"node-exporter\"} / node_memory_MemTotal_bytes{job=\"node-exporter\"}) and on (instance) group by (instance) (node_boot_time_seconds{job=\"node-exporter\", instance!~\"k8s-.*\"})) or label_replace(max(100 * (servers_Voyager_local_memory_memory_wired + servers_Voyager_local_memory_memory_active) / (servers_Voyager_local_memory_memory_wired + servers_Voyager_local_memory_memory_active + servers_Voyager_local_memory_memory_inactive + servers_Voyager_local_memory_memory_laundry + servers_Voyager_local_memory_memory_free)), \"instance\", \"voyager\", \"\", \"\") or label_replace(max(homeassistant_sensor_unit_percent{job=\"home-assistant\", friendly_name=\"Router Memory usage\"}), \"instance\", \"hubble\", \"\", \"\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "max by (instance) (100 * (1 - node_filesystem_avail_bytes{job=\"node-exporter\", mountpoint=~\"/|/var\", fstype=~\"ext4|xfs\"} / node_filesystem_size_bytes{job=\"node-exporter\", mountpoint=~\"/|/var\", fstype=~\"ext4|xfs\"}) and on (instance) group by (instance) (node_boot_time_seconds{job=\"node-exporter\", instance!~\"k8s-.*\"})) or label_replace(100 * sum({__name__=~\"servers_Voyager_local_df_mnt_Voyager(_.+)?_df_complex_used\"}) / (sum({__name__=~\"servers_Voyager_local_df_mnt_Voyager(_.+)?_df_complex_used\"}) + sum(servers_Voyager_local_df_mnt_Voyager_df_complex_free)), \"instance\", \"voyager\", \"\", \"\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "max by (instance) (node_hwmon_temp_celsius{job=\"node-exporter\"} and on (instance) group by (instance) (node_boot_time_seconds{job=\"node-exporter\", instance!~\"k8s-.*\"})) or label_replace(max(label_replace(max({__name__=~\"servers_Voyager_local_cputemp_.+_temperature\"}) / 10 - 273.15, \"s\", \"cpu\", \"\", \"\") or label_replace(max({__name__=~\"servers_Voyager_local_disktemp_.+_temperature\"}), \"s\", \"disk\", \"\", \"\")), \"instance\", \"voyager\", \"\", \"\") or label_replace(max(homeassistant_sensor_temperature_celsius{job=\"home-assistant\", friendly_name=\"Router CPU temperature\"}), \"instance\", \"hubble\", \"\", \"\")",
          "format": "table",
          "instant": true
        },
        {
          "refId": "F",
          "expr": "min by (instance) (smartctl_device_smart_status)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "G",
          "expr": "max by (instance) (smartctl_device_percentage_used)",
          "format": "table",
          "instant": true
        },
        {
          "refId": "H",
          "expr": "sum by (instance) (rate(node_rapl_psys_joules_total[5m]))",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "instance": 0,
              "Value #U": 1,
