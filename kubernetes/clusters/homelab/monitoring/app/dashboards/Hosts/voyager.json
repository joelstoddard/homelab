{
  "id": null,
  "uid": "homelab-host-voyager",
  "title": "Voyager",
  "description": "Voyager, the TrueNAS CORE host, in the host layout: temperatures, disks, CPU, memory, network and syslog. Pool, dataset, ZFS and NFS detail is on Storage / TrueNAS. From its collectd Graphite stream (job=\"truenas\", names servers_Voyager_local_*) and its syslog. The names are CORE's; a move to SCALE changes them. docs/design/host-monitoring.md.",
  "tags": [
    "hosts"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "links": [
    {
      "type": "link",
      "title": "Hosts overview",
      "url": "/d/homelab-hosts-overview",
      "icon": "dashboard"
    },
    {
      "type": "link",
      "title": "TrueNAS storage",
      "url": "/d/homelab-truenas",
      "icon": "dashboard"
    }
  ],
  "templating": {
    "list": [
      {
        "name": "search",
        "label": "Contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
