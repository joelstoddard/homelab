    {
      "type": "bargauge",
      "title": "Filesystem used",
      "description": "Used share of each mounted filesystem (tmpfs and the Proxmox cluster filesystem excluded).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{instance=\"rumba\", fstype!~\"tmpfs|fuse.*\"} / node_filesystem_size_bytes{instance=\"rumba\", fstype!~\"tmpfs|fuse.*\"})",
          "legendFormat": "{{mountpoint}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
