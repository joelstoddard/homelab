{
  "id": null,
  "uid": "homelab-host-mir",
  "title": "Mir",
  "description": "One physical host: temperatures, fans, power, SMART, storage, CPU, memory, network and logs, as far as the host reports them. Generated by hosts.py from templates/host.json; do not edit the generated file. docs/design/host-monitoring.md.",
