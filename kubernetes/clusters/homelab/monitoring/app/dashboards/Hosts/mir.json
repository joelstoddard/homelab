        {
          "refId": "D",
          "expr": "node_memory_SwapTotal_bytes{instance=\"mir\"} - node_memory_SwapFree_bytes{instance=\"mir\"}",
          "legendFormat": "Swap used"
        },
        {
          "refId": "E",
          "expr": "node_memory_MemTotal_bytes{instance=\"mir\"}",
          "legendFormat": "Total"
