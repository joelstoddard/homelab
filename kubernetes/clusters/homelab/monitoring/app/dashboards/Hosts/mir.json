        },
        {
          "refId": "B",
          "expr": "node_memory_MemAvailable_bytes{instance=\"mir\"}",
          "legendFormat": "Available"
        },
        {
          "refId": "C",
          "expr": "node_memory_Cached_bytes{instance=\"mir\"} + node_memory_Buffers_bytes{instance=\"mir\"}",
