    {
      "type": "timeseries",
      "title": "CPU by mode",
      "description": "Where non-idle CPU time goes, as a share of all cores. iowait is time idle while waiting on disk.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * sum by (mode) (rate(node_cpu_seconds_total{instance=\"mir\", mode!=\"idle\"}[$__rate_interval])) / scalar(count(node_cpu_seconds_total{instance=\"mir\", mode=\"idle\"}))",
          "legendFormat": "{{mode}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
