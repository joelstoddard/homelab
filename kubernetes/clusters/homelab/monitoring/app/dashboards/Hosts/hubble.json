{
  "uid": "homelab-router",
  "title": "Hubble",
  "description": "Hubble, the router, as a host: its own CPU, memory, temperature, uptime, WAN rate and totals, and connected devices, read by Home Assistant's ASUSWRT integration from /api/prometheus, plus its syslog. docs/design/host-monitoring.md.",
  "tags": [
    "hosts"
  ],
  "schemaVersion": 39,
  "editable": false,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "templating": {
    "list": [
      {
        "name": "search",
        "label": "Contains",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "annotations": {
    "list": [{"name": "Flux", "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "iconColor": "purple", "target": {"type": "tags", "tags": ["flux"], "matchAny": true, "limit": 100}}, {"name": "NetBox", "datasource": {"type": "netboxlabs-netbox-datasource", "uid": "netbox"}, "enable": true, "iconColor": "blue", "target": {"refId": "Anno", "queryType": "annotations"}}, {"name": "Operator", "datasource": {"type": "grafana", "uid": "-- Grafana --"}, "enable": true, "iconColor": "orange", "target": {"type": "tags", "tags": ["operator"], "matchAny": true, "limit": 100}}]
  },
  "panels": [
    {
      "type": "table",
      "title": "NetBox",
      "description": "This host's NetBox device record, read at view time. The NetBox cell links to the record.",
      "id": 15,
      "gridPos": {
        "h": 3,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "netboxlabs-netbox-datasource",
        "uid": "netbox"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "netboxlabs-netbox-datasource",
            "uid": "netbox"
          },
          "queryType": "objects",
          "objectType": "dcim/devices",
          "filters": [
            {
              "field": "name",
              "operator": "ie",
              "value": "hubble"
            }
          ],
          "fields": [
            "name",
            "role",
            "device_type",
            "site",
            "platform",
            "status",
            "primary_ip4",
            "description",
            "display_url"
          ],
          "limit": 1
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "name": 0,
              "role": 1,
              "device_type": 2,
              "site": 3,
              "platform": 4,
              "status": 5,
              "primary_ip4": 6,
              "description": 7
            },
            "renameByName": {
              "name": "NetBox",
              "role": "NetBox role",
              "device_type": "NetBox model",
              "site": "NetBox site",
              "platform": "NetBox platform",
              "status": "NetBox status",
              "primary_ip4": "NetBox primary IP",
              "description": "NetBox description"
            },
            "excludeByName": {}
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "noValue": "\u2014"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "NetBox"
            },
            "properties": [
              {
                "id": "noValue",
                "value": "not in NetBox"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "display_url"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Uptime",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (friendly_name) (homeassistant_sensor_duration_s{job=\"home-assistant\",friendly_name=~\"Router Uptime\"})",
          "legendFormat": "{{friendly_name}}",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
