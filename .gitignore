**/.venv
.DS_Store

# Operator-local Claude Code state: handoff drafts, scratch specs,
# session-private notes. Not for shared history.
.claude/

# Inventories carry MAC addresses, static IPs, and (for offsites)
# public IPs — local secrets, not for public history. Operators copy
# the *.example files to *.yaml and fill in their environment.
ansible/inventory/*.yaml
!ansible/inventory/*.yaml.example
# netbox.yaml and local.yaml are config, not secrets — hardcoded URL
# (in netbox.yaml) and a static localhost stub (in local.yaml).
!ansible/inventory/netbox.yaml
!ansible/inventory/local.yaml

# Galaxy-installed roles are vendored at runtime by `make dev` into
# ansible/roles/. Custom roles are either numbered (00-pxe,
# 01-wake-on-lan, 02-preflights, ...) or OS-named (proxmox, future
# talos / truenas); galaxy roles have a vendor.name shape — ignore
# the latter.
ansible/roles/*.*/
