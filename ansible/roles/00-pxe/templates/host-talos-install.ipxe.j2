#!ipxe
# {{ target_hostname }} ({{ mac_address }}) — generated by Ansible
# INSTALL marker + boot. Served ONLY while this host is being (re)provisioned
# (it is in talos_pi_provision_hosts). Its mere presence is what makes the
# dispatcher (<mac>.ipxe) netboot Talos instead of the local disk.
#
# Netboot Talos {{ talos_version }} (arm64) into MAINTENANCE MODE. No
# talos.config is passed, so the node waits for the talos role's
# `talosctl apply-config` (see playbooks/talos.yaml).

set base http://{{ pxe_server_ip }}
set mac_dash ${mac:hexhyp}

echo
echo Booting Talos {{ talos_version }} (arm64) for {{ target_hostname }} (${mac_dash})
echo Node will land in maintenance mode and await talosctl apply-config.
echo

kernel ${base}/talos/{{ talos_version }}/vmlinuz-arm64 \
    {{ talos_kernel_cmdline }}

initrd ${base}/talos/{{ talos_version }}/initramfs-arm64.xz

boot
