#!ipxe
# {{ target_hostname }} ({{ mac_address }}) — generated by Ansible
# DISPATCHER (always served). If an install marker (<mac>.install.ipxe) exists
# for this host, chain to it (→ Talos maintenance mode). Otherwise boot the
# locally-installed OS off /dev/sda. The marker is created/removed by the
# 00-pxe talos task from talos_pi_provision_hosts, so a provisioned Pi boots
# its disk on every later reboot instead of re-entering maintenance mode.
#
# NOTE: the no-marker fallback (sanboot the local disk vs. letting the EEPROM
# fall through to its USB entry) is validated on the canary — see plan Gate C.

set base http://{{ pxe_server_ip }}

chain --autofree ${base}/boot/${mac:hexhyp}.install.ipxe || sanboot --no-describe --drive 0x80 || exit
