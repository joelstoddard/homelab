#!ipxe
# {{ target_hostname }} ({{ mac_address }}) — generated by Ansible
# Boot the Debian {{ debian_version }} netinstall, drive it via per-host preseed.

set base http://{{ pxe_server_ip }}
set mac_dash ${mac:hexhyp}

echo
echo Booting Debian {{ debian_version }} installer for {{ target_hostname }} (${mac_dash})
echo

kernel ${base}/debian/{{ debian_version }}/linux \
    auto=true \
    url=${base}/preseed/${mac_dash}.cfg \
    interface=auto \
    netcfg/dhcp_timeout=60 \
    netcfg/link_wait_timeout=30 \
    hostname={{ target_hostname }} \
    domain={{ fqdn | regex_replace('^[^.]+\\.', '') }} \
    {{ installed_kernel_cmdline }} \
    console=tty0

initrd ${base}/debian/{{ debian_version }}/initrd.gz

boot
