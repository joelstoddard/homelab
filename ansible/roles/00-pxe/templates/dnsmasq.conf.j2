# Generated by Ansible — do not edit by hand.

# Disable DNS — we only want DHCP-proxy + TFTP. Avoids fighting
# systemd-resolved (or any other resolver) for port 53.
port=0

# DHCP behaviour
{% if dhcp_proxy %}
# Proxy mode: do not allocate IPs, only handle PXE handshake.
dhcp-range={{ ansible_default_ipv4.network }},proxy,{{ ansible_default_ipv4.netmask }}
{% else %}
# Authoritative mode: allocate IPs in the configured range.
dhcp-range={{ ansible_default_ipv4.network | ansible.utils.ipmath(1) }},{{ ansible_default_ipv4.network | ansible.utils.ipmath(99) }}
dhcp-option=3,{{ ansible_default_ipv4.gateway }}
{% endif %}

# Match UEFI x86_64 PXE clients (client-arch 7 and 9 == x64 EFI).
dhcp-match=set:efi-x86_64,option:client-arch,7
dhcp-match=set:efi-x86_64,option:client-arch,9

# Match UEFI arm64 PXE clients (client-arch 11 == ARM64 EFI) — the Pis once
# EDK2 UEFI is running. dnsmasq has no symbolic name for this arch, so the
# pxe-service below uses the numeric type.
dhcp-match=set:efi-arm64,option:client-arch,11

# Match the bare Pi 4 EEPROM netboot — the FIRST round, before EDK2. The Pi
# firmware is not yet a UEFI client and identifies via the "PXEClient:Arch:
# 00000" vendor class; it TFTPs the EDK2 firmware tree (config.txt, start4.elf,
# RPI_EFI.fd) from the TFTP root. PROVISIONAL: confirm the exact vendorclass/
# arch this Pi firmware sends from `docker logs files-dnsmasq-1` (log-dhcp) on
# the canary and correct this if needed — Pi-4 native netboot in proxy mode is
# the main unknown (see plan R1).
dhcp-vendorclass=set:rpi-fw,PXEClient:Arch:00000

# Detect iPXE clients (they identify via DHCP user-class option).
dhcp-userclass=set:ipxe,iPXE

{% if dhcp_proxy %}
# Stage 1: non-iPXE PXE clients (firmware ROM) — send the iPXE chainloader.
# x86_64 (the NUCs) and arm64 (the Pis) get arch-matched builds.
pxe-service=tag:efi-x86_64,tag:!ipxe,X86-64_EFI,"Boot iPXE",ipxe.efi
pxe-service=tag:efi-arm64,tag:!ipxe,11,"Boot iPXE (arm64)",ipxe-arm64.efi
# Bare Pi 4 EEPROM netboot → point it at the TFTP server; it then fetches the
# EDK2 firmware tree (config.txt → RPI_EFI.fd) from the root. PROVISIONAL (R1).
pxe-service=tag:rpi-fw,tag:!ipxe,0,"Raspberry Pi 4 EEPROM netboot"
# Stage 2: iPXE-already-running clients — send them the per-host HTTP script
# (iPXE expands ${mac:hexhyp} to its booting NIC's MAC at fetch time). The
# script is arch-agnostic: each host's script was rendered for its OS.
dhcp-boot=tag:ipxe,http://{{ pxe_server_ip }}/boot/${mac:hexhyp}.ipxe
{% else %}
# In authoritative mode, set boot file directly per stage.
dhcp-boot=tag:efi-x86_64,tag:!ipxe,ipxe.efi
dhcp-boot=tag:efi-arm64,tag:!ipxe,ipxe-arm64.efi
dhcp-boot=tag:ipxe,http://{{ pxe_server_ip }}/boot/${mac:hexhyp}.ipxe
{% endif %}

# Restrict DHCP responses to known PXE-managed hosts (rumba, tango, …).
{% for host in groups['pxe'] %}
dhcp-mac=set:known,{{ hostvars[host]['mac_address'] }}
{% endfor %}
dhcp-ignore=tag:!known

# TFTP serves only ipxe.efi from /var/tftp.
enable-tftp
tftp-root=/var/tftp

# Logging (visible via docker logs files-dnsmasq-1).
log-queries
log-dhcp
