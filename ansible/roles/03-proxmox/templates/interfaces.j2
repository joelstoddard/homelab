# /etc/network/interfaces — Proxmox-style with vmbr0 bridge.

auto lo
iface lo inet loopback

iface {{ proxmox_bridge_iface }} inet manual

auto vmbr0
iface vmbr0 inet static
    address {{ proxmox_bridge_address }}
    gateway {{ proxmox_bridge_gateway }}
    bridge-ports {{ proxmox_bridge_iface }}
    bridge-stp off
    bridge-fd 0
