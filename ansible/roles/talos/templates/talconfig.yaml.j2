{#
  talhelper config, rendered from NetBox/inventory — NetBox stays the
  source of truth. `talhelper genconfig` turns this into per-node machine
  configs under clusterconfig/. Generated by the talos role; do not edit
  the rendered copy in .talos/.

  Per-node facts come from hostvars[item]:
    - ipAddress    <- ansible_host (NetBox primary IP)
    - controlPlane <- membership in talos_controlplane_hosts (NetBox tag)
    - arch/overlay <- 'pis' group membership (NetBox device_type)
#}
clusterName: {{ talos_cluster_name }}
talosVersion: {{ talos_version }}
kubernetesVersion: {{ talos_kubernetes_version }}
endpoint: {{ talos_cluster_endpoint }}

# No flannel, no kube-proxy: Cilium is the CNI and the service datapath. The
# role seeds it right after bootstrap (tasks/cni.yaml) and Flux owns it from
# then on (kubernetes/cilium/) — docs/design/cilium-bootstrap.md. KubePrism
# keeps its default (:7445); Cilium's kube-proxy replacement points at it.
cniConfig:
  name: none
patches:
  - |-
    cluster:
      proxy:
        disabled: true
  # Longhorn keeps its replicas in /var/lib/longhorn on EPHEMERAL, and the
  # CSI plugin's volume mounts must propagate into the kubelet's mount
  # namespace (rshared) — docs/design/longhorn.md. Applies without a reboot.
  - |-
    machine:
      kubelet:
        extraMounts:
          - destination: /var/lib/longhorn
            type: bind
            source: /var/lib/longhorn
            options:
              - bind
              - rshared
              - rw

nodes:
{% for item in groups['talos'] | default([]) %}
{%   set is_cp = item in talos_controlplane_hosts %}
{%   set is_pi = 'pis' in hostvars[item].group_names %}
{%   set zone_device = hostvars[item].cluster_device | default(none, true) %}
{%   set zone = (zone_device.name if zone_device else item) | lower %}
  - hostname: {{ item }}
    ipAddress: {{ hostvars[item].ansible_host }}
    controlPlane: {{ is_cp | lower }}
    installDisk: {{ talos_install_disk }}
    # Image Factory installer; talhelper appends :{{ talos_version }}. The Pi
    # schematic carries the USB quirk (a UKI cmdline is fixed at build time).
    talosImageURL: factory.talos.dev/installer/{{ talos_pi_schematic_id if is_pi else talos_schematic_id }}
    # Failure domain for Longhorn replica placement: the physical host. A VM
    # reports the NUC NetBox places it on (cluster_device); a Pi is its own.
    nodeLabels:
      topology.kubernetes.io/zone: {{ zone }}
{#
      Static addressing from NetBox: the node's identity is its NetBox MAC
      (deviceSelector — immune to kernel/udev interface renames like the
      v1.9 eth0→end0 switch on the Pis), its address the NetBox primary IP.
      Prefix length + gateway come from the operator's own LAN facts at
      render time (same L2 segment as every node). Maintenance mode still
      DHCPs (transient rendezvous, discovered by MAC); this static config
      takes over from first installed boot.
#}
    networkInterfaces:
{%   set mac = hostvars[item].mac_address | default('') %}
      - deviceSelector:
{%   if mac %}
          hardwareAddr: "{{ mac | lower }}"
{%   else %}
          physical: true   {# no MAC in NetBox: match the single physical NIC #}
{%   endif %}
        addresses:
          - {{ hostvars[item].ansible_host }}/{{ talos_network_prefixlen }}
        routes:
          - network: 0.0.0.0/0
            gateway: {{ talos_network_gateway }}
{%   if is_cp %}
        vip:
          ip: {{ talos_vip }}
{%   endif %}
{% endfor %}

# Make the VIP valid for the control-plane Talos API (apid) certs. Talos adds
# the endpoint host to the kube-apiserver cert by itself. (A talhelper field,
# not a JSON6902 patch: talhelper emits multi-document configs from Talos 1.12
# on, and those do not support JSON6902.)
controlPlane:
  certSANs:
    - {{ talos_vip }}
  # Control-plane only (talhelper applies these to controlPlane: true nodes).
  # Talos binds the scheduler and controller-manager to localhost and gives
  # etcd no metrics listener; the alloy layer scrapes all three by node
  # address — docs/design/observability.md. The etcd URL is plain HTTP on the
  # LAN and serves /metrics and /health only. Rolled out with
  # `make -C ansible apply-upgrade` (etcd needs the reboot the play performs).
  patches:
    - |-
      cluster:
        controllerManager:
          extraArgs:
            bind-address: 0.0.0.0
        scheduler:
          extraArgs:
            bind-address: 0.0.0.0
        etcd:
          extraArgs:
            listen-metrics-urls: http://0.0.0.0:2381
