{#
  Per-node worker patch, merged onto the base worker.yaml by
  `talosctl machineconfig patch`. `item` is the node's inventory hostname.
#}
machine:
  network:
    hostname: {{ item }}
    interfaces:
      - interface: {{ talos_primary_interface }}
        dhcp: true
  install:
    # /dev/sda for all nodes: VM scsi0 and the Pis' USB→NVMe SSD both
    # enumerate as /dev/sda. See talos_install_disk in the role defaults.
    disk: {{ talos_install_disk }}
    image: {{ talos_install_image }}
    wipe: false
