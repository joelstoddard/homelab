{# Control-plane nodes only: why the VIP SAN sits in machine.certSANs alone and why the label is
   deleted is in docs/design/talos-machine-config.md. The metrics listeners: docs/design/observability.md. #}
machine:
{% if talos_static_network %}
  certSANs:
    - {{ talos_vip }}
{% endif %}
  nodeLabels:
    node.kubernetes.io/exclude-from-external-load-balancers:
      $patch: delete
cluster:
  controllerManager:
    extraArgs:
      bind-address: 0.0.0.0
  scheduler:
    extraArgs:
      bind-address: 0.0.0.0
  etcd:
    extraArgs:
      listen-metrics-urls: http://0.0.0.0:2381
{% if talos_static_network %}
{# The scraper runs on a worker and arrives masqueraded to that worker's address, so the workers
   are the sources (docs/design/observability.md). Skylab's default-deny closes :2381 already. #}
---
apiVersion: v1alpha1
kind: NetworkRuleConfig
name: etcd-metrics
portSelector:
  ports:
    - 2381
  protocol: tcp
ingress:
{% for worker in talos_cluster_hosts | difference(talos_controlplane_hosts) | sort %}
  - subnet: {{ hostvars[worker].ansible_host }}/32
{% endfor %}
{% endif %}
