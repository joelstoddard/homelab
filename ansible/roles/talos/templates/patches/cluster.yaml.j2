{# All nodes. No CNI and no kube-proxy, because Cilium is both (docs/design/cilium-bootstrap.md).
   Longhorn needs its data dir bind-mounted rshared into the kubelet (docs/design/longhorn.md). #}
cluster:
  network:
    cni:
      name: none
  proxy:
    disabled: true
machine:
  kubelet:
    extraMounts:
      - destination: /var/lib/longhorn
        type: bind
        source: /var/lib/longhorn
        options:
          - bind
          - rshared
          - rw
