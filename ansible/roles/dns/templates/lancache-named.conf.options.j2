// Managed by ansible (roles/dns); ansible/roles/dns/README.md gives the reasons.
// dnstool string-replaces this file at every container start, so it must
// contain none of the dnstool placeholders: do not name them, even in a comment.

acl dns_chain {
    localhost;
{% for addr in dns_pihole_addresses.values() | sort %}
    {{ addr }};
{% endfor %}
};

options {
  directory "/var/cache/bind";

  // Off because this container forges answers for signed CDN domains. Bind9,
  // the next link down, validates instead.
  dnssec-validation no;

  auth-nxdomain no;
  allow-recursion   { dns_chain; };
  allow-query       { dns_chain; };
  allow-query-cache { dns_chain; };
  listen-on { {{ dns_lancache_addresses[inventory_hostname] }}; 127.0.0.1; };
  listen-on-v6 { none; };
  forward only;

  // Permit RFC1918 PTR lookups to be recursed upstream.
  empty-zones-enable no;
  response-policy { zone "rpz"; };
  rrset-order { order cyclic; };
  forwarders { {{ dns_bind9_addresses.values() | sort | join('; ') }}; };
};
