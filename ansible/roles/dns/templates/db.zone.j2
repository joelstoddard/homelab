{#
  The authoritative LAN zone. See docs/design/dns-chain.md.

  Nothing transfers this zone, so the serial and the refresh, retry and
  expire timers are never read. Switch to a YYYYMMDDNN serial before adding
  any secondary.
#}
$TTL {{ dns_zone_ttl }}
@   IN SOA ns1.{{ dns_domain }}. hostmaster.{{ dns_domain }}. (
        1 ; serial
        3600 ; refresh
        600 ; retry
        604800 ; expire
        {{ dns_zone_negative_ttl }} ) ; negative cache TTL

{% for host in dns_bind9_addresses | sort %}
    IN NS ns{{ loop.index }}.{{ dns_domain }}.
{% endfor %}
{% for host in dns_bind9_addresses | sort %}
ns{{ loop.index }} IN A {{ dns_bind9_addresses[host] }}
{% endfor %}

; Every cluster service, by one wildcard. Adding a service is one route
; object and nothing else.
@   IN A {{ dns_traefik_lb_ip }}
*   IN A {{ dns_traefik_lb_ip }}

; Each passthrough name is delegated out of this zone. Without that, BIND
; answers it from the wildcard and never consults its forward zone.
{% for name in dns_passthrough_names %}
{{ name }}. IN NS ns1.{{ dns_domain }}.
{% endfor %}

; Static records go below, in zone format. An explicit record shadows the
; wildcard, so never add a host that kubernetes/lan-services/ fronts: the
; name would reach the host directly and serve its own certificate.
