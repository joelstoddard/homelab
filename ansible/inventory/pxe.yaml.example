---
# Copy this file to pxe.yaml and fill in real values for your environment.
# pxe.yaml itself is gitignored — its contents (MAC addresses + LAN IPs)
# are local secrets that allow MAC-spoofing impersonation if leaked.

# Localhost runs the PXE-server-setup play. Pin the interpreter to the same
# Python that's running ansible-playbook so community.docker can find the
# `docker` SDK installed in the venv (and not /usr/bin/python3).
local:
  hosts:
    localhost:
      ansible_connection: local
      ansible_python_interpreter: "{{ ansible_playbook_python }}"

# All PXE-managed hosts. Subgroups select per-OS install path.
pxe:
  children:
    proxmox:
      hosts:
        # Replace the example entries below with your hosts. mac_address
        # drives the dnsmasq DHCP allowlist + per-MAC iPXE/preseed
        # template generation; disk_device is consumed by partman.
        # rumba:
        #   ansible_host: 192.168.1.202
        #   ansible_user: root
        #   fqdn: "rumba.example.lan"
        #   mac_address: "aa:bb:cc:dd:ee:01"
        #   disk_device: "/dev/nvme0n1"
        # tango:
        #   ansible_host: 192.168.1.203
        #   ansible_user: root
        #   fqdn: "tango.example.lan"
        #   mac_address: "aa:bb:cc:dd:ee:02"
        #   disk_device: "/dev/nvme0n1"
    # The arm64 Pis netboot Talos over u-boot, so they are PXE-managed too.
    # dnsmasq offers the u-boot chain only to hosts listed in
    # talos_pi_provision_hosts; every other Pi falls through to local disk.
    talos:
      children:
        pis:
    # truenas:  # placeholder — strategy deferred

# Hardware class: nesting it under talos (and so under pxe) above puts each Pi
# in all three groups from one definition — the membership NetBox derives from
# device_type, platform and tag. ansible_user is only for the pre-cutover
# EEPROM play; a Pi on Talos answers no SSH.
pis:
  hosts:
    # kosmos:
    #   ansible_host: 192.168.1.21
    #   ansible_user: pi-admin
    #   fqdn: kosmos.example.lan
    #   mac_address: "aa:bb:cc:dd:ee:11"
    #   disk_device: "/dev/sda"
