---
# Copy this file to main.yaml and fill in real values for your environment.
# main.yaml itself is gitignored — LAN IPs and offsite addresses live here.
#
# This is the bootstrap fallback for environments without NetBox. The group
# names below are the ones the playbooks target, and they mirror what
# netbox.yaml's keyed_groups derive — see README.md for the full table.

# Talos nodes: the k8s VMs on the NUCs plus the Pis. playbooks/talos.yaml
# targets this group but runs `connection: local`, driving each node over the
# Talos API — Talos has neither SSH nor Python, so ansible_host is what
# talosctl is pointed at, not something Ansible connects to.
talos:
  hosts:
    # k8s-server-01:
    #   ansible_host: 192.168.1.31
    # k8s-agent-01:
    #   ansible_host: 192.168.1.35

pis:
  hosts:
    # kosmos:
    #   ansible_host: 192.168.1.21

nucs:
  hosts:
    # rumba:
    #   ansible_host: 192.168.1.202
    #   ansible_user: root
    #   fqdn: rumba.example.lan

# Hosts that should be running Proxmox VE. playbooks/main.yaml runs
# the 02-preflights orchestrator, which dispatches the proxmox role's
# debian-to-pve, cluster, and api-token tasks for hosts in this group.
# A host must live here (directly or via children) to be converted.
# The debian-to-pve task uses `fqdn` to pin /etc/hosts so pmxcfs can
# resolve the hostname off the loopback — set it on each host (or via
# group_vars).
proxmox:
  children:
    nucs:
  # hosts:
  #   <bare-metal-host>:
  #     ansible_host: <ip>
  #     ansible_user: root
  #     fqdn: <host>.example.lan

# Hosts running Grafana Alloy outside the cluster: the NUCs, plus the Pi-hole
# LXC, which has no PXE story of its own. playbooks/alloy.yaml targets
# `alloy:!talos`; group_vars/alloy.yaml sets ansible_user for the whole group,
# so only the address is needed per host.
alloy:
  children:
    nucs:
  # hosts:
  #   pihole:
  #     ansible_host: 192.168.1.53

# Offsite hosts (e.g., cloud VPS) — public IPs/hostnames go here when
# you copy this file to main.yaml. Leave commented in the example.
# offsites:
#   hosts:
#     <hostname>:
#       ansible_host: <public-ip-or-hostname>
#       ansible_user: "ops"
